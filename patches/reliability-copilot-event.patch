+                else:
+                    payload, self.buffer = rest[: close.start()], rest[close.end():]
+            payload = _SCAFFOLD_TOKEN.sub("", payload)
+            name = match.group(1).lower()
+            if name in _ANSWER_ROLES:
+                self.mode = "answer"
+                whole = payload.strip()
+                if whole and whole == self._last_answer_block:
+                    continue
+                if whole:
+                    self._last_answer_block = whole
+                self._emit_answer_text(payload, events)
+            elif payload.strip():
+                events.append(("thought", payload.strip()))
+        return events
+
+    def _drain_answer_lines(self, final: bool = False) -> list[tuple[str, str]]:
+        """Emit buffered answer-mode lines; scaffolding lines become thought."""
+        events: list[tuple[str, str]] = []
+        while "\n" in self.buffer:
+            line, _, self.buffer = self.buffer.partition("\n")
+            if _is_scaffold_line(line):
+                if line.strip():
+                    events.append(("thought", line))
+                continue
+            if line.strip() and line.strip() == self._last_answer_line:
+                continue
+            if line.strip():
+                self._last_answer_line = line.strip()
