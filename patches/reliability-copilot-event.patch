+"""Weibull probability-paper plotting — deterministic, no LLM.
+
+Extracted from the former ``life_data_analysis_weibull.py`` so that
+``weibull_fit.py`` remains the sole calculation source (AGENTS.md rule #2).
+Only targeted warning filters are applied; global suppression was removed.
+"""
+
+from __future__ import annotations
+
+import warnings
+from collections.abc import Callable
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+from matplotlib import ticker
+from matplotlib.gridspec import GridSpec
+from scipy import stats
+
+from src.domains.reliability.tools._common import STATIC_DIR, plot_path_for
+from src.domains.reliability.weibull_fit import b_life, bootstrap_bounds, fit_weibull
+
+# Targeted warning suppression — global ignore was removed.
+try:
+    from numpy.exceptions import RankWarning as _RankWarning
+except ImportError:
+    from numpy import RankWarning as _RankWarning  # type: ignore[no-redef,attr-defined]
+
+warnings.filterwarnings("ignore", category=_RankWarning)
+warnings.filterwarnings(
+    "ignore",
+    message="This figure includes Axes that are not compatible with tight_layout.*",
+    category=UserWarning,
+)
+
+# ---------------------------------------------------------------------------
+# Colours — matching the look of real printed Weibull probability paper
+# ---------------------------------------------------------------------------
+_PAPER_BG = "#fdf8f0"  # warm cream (the paper itself)
+_GRID_MAJOR = "#7ecfd4"  # teal-cyan major grid lines
+_GRID_MINOR = "#c9eef0"  # very light cyan minor grid lines
+_BAND_YEL = "#fffacc"  # yellow β header band
+_BAND_EDGE = "#d4c84a"  # yellow band border
+
+
+def weibull_cdf(t, beta, eta):
+    """Weibull CDF ``F(t)=1−exp(−(t/η)^β)``."""
+    return 1 - np.exp(-((t / eta) ** beta))
+
+
+def linearize_weibull(t, F):  # pragma: no cover — kept for shim compat
+    """Legacy helper — use weibull_probability_paper()._y() instead.
+
+    From: F(t) = 1 - exp(-(t/eta)^beta)
+        => y = ln(ln(1/(1-F))) = beta*ln(t) - beta*ln(eta),  y = mx + c
+    Retained so external callers importing via the deprecated shim still work.
+    """
+    Fp = np.clip(np.asarray(F, dtype=float), 1e-10, 1 - 1e-10)
+    return np.log(np.asarray(t, dtype=float)), np.log(np.log(1.0 / (1.0 - Fp)))
+
+
+def weibull_probability_paper(
+    ax: plt.Axes,
+    title: str,
+    x_left: float,
+    x_right: float,
+) -> tuple[float, float, Callable, plt.Axes, Callable]:
+    """Set up Weibull probability paper on *ax*.
+
+    Parameters
+    ----------
+    ax      : Axes to configure (x-scale will be set to log).
+    title   : Plot title (rendered above the β band).
+    x_left  : Left x-limit in the same units as failure times.
+    x_right : Right x-limit.
+
+    Returns
+    -------
+    y_min, y_max, _y, ax_top, draw_band
+        y_min / y_max : y-limits in Weibull-linearised space.
+        _y            : Callable ``(percent: float) -> float``.
+        ax_top        : The twiny Axes for the β scale (fully hidden — the
+                        band and tick labels are drawn by draw_band()).
+        draw_band     : Zero-argument callable that MUST be called after all
+                        plot elements are added and BEFORE fig.savefig().
+                        It calls fig.canvas.draw() to lock layout then paints
+                        the yellow β header band with tick labels.
+    """
+
+    def _y(p: float) -> float:
+        """ln(ln(1 / (1 − F))) — Weibull probability paper y-transform."""
+        p = float(np.clip(p, 1e-6, 100.0 - 1e-6))
+        return float(np.log(np.log(1.0 / (1.0 - p / 100.0))))
+
+    # ------------------------------------------------------------------
+    # Y probability levels
+    # ------------------------------------------------------------------
+    prob_major = [
+        0.10,
+        0.20,
+        0.30,
+        0.50,
+        1.00,
+        2.00,
+        3.00,
+        5.00,
+        10.0,
+        20.0,
+        30.0,
+        50.0,
+        63.2,
+        70.0,
+        80.0,
+        90.0,
+        95.0,
+        99.0,
+        99.9,
+    ]
+    # Log-spaced minor lines between each consecutive major pair
+    _minor_probs: list[float] = []
+    for i in range(len(prob_major) - 1):
+        lo, hi = prob_major[i], prob_major[i + 1]
+        _minor_probs.extend(float(v) for v in np.logspace(np.log10(lo), np.log10(hi), 6)[1:-1])
+
+    y_major = [_y(p) for p in prob_major]
+    # Tight limits — exactly 0.10 % to 99.9 %, no padding, so "100" never appears
+    y_min = _y(0.10)
+    y_max = _y(99.9)
+    y_632 = _y(63.2)  # ≈ 0 by the Weibull characteristic definition
+
+    # ------------------------------------------------------------------
+    # Paper background + horizontal grid
+    # ------------------------------------------------------------------
+    ax.set_facecolor(_PAPER_BG)
+
+    for y, p in zip(y_major, prob_major):
+        lw = 0.9 if p in (1, 10, 50, 90, 99) else 0.55
+        ax.axhline(y, color=_GRID_MAJOR, linewidth=lw, zorder=1)
+    for p in _minor_probs:
+        ax.axhline(_y(p), color=_GRID_MINOR, linewidth=0.35, zorder=1)
+
+    # Y-axis ticks — locked to our explicit set; no auto additions
+    ax.set_yticks(y_major)
+    ax.set_yticklabels(
+        [f"{p:.2f}" if p < 1.0 else (f"{p:.1f}" if p < 10.0 else ("99.9" if p == 99.9 else f"{p:.0f}")) for p in prob_major],
+        fontsize=7.5,
+    )
+    ax.set_ylim(y_min, y_max)
+    ax.yaxis.set_major_locator(ticker.FixedLocator(y_major))
+    ax.yaxis.set_minor_locator(ticker.NullLocator())
+    ax.yaxis.grid(False)  # manual horizontal lines above; suppress auto grid
+    ax.set_ylabel("Cumulative Unreliability  F(t)  [%]", fontsize=9)
+
+    # η pivot dot on the left spine at 63.2 %
+    ax.plot(
+        x_left,
+        y_632,
+        "o",
+        markersize=8,
+        color="navy",
+        markerfacecolor="white",
+        markeredgewidth=2.0,
+        clip_on=False,
+        zorder=9,
+    )
+    ax.annotate(
+        "η",
+        xy=(1.016, (y_632 - y_min) / (y_max - y_min)),
+        xycoords="axes fraction",
+        fontsize=13,
+        fontweight="bold",
+        color="navy",
+        va="center",
+        ha="left",
+    )
+
+    # ------------------------------------------------------------------
+    # X-axis — log scale, both major and minor vertical grid
+    # ------------------------------------------------------------------
+    ax.set_xscale("log")
+    ax.set_xlim(x_left, x_right)
+    ax.set_xlabel("Time to Failure  [hours,  log scale]", fontsize=9)
+    ax.xaxis.set_major_formatter(ticker.FuncFormatter(lambda v, _: f"{v:g}"))
+    ax.xaxis.set_major_locator(ticker.LogLocator(base=10.0, numticks=15))
+    ax.xaxis.set_minor_locator(ticker.LogLocator(base=10.0, subs=np.arange(2, 10), numticks=100))
+    ax.grid(True, which="major", axis="x", color=_GRID_MAJOR, linewidth=0.7, zorder=1)
+    ax.grid(True, which="minor", axis="x", color=_GRID_MINOR, linewidth=0.35, zorder=1)
+    ax.set_axisbelow(True)
+
+    # ------------------------------------------------------------------
+    # β shape-reference scale — top spine
+    #
+    # Geometry:
+    #   Pivot  : (x_left, y_632) in (time, Weibull-y) space.
+    #   Line of slope β through pivot reaches y = y_max at:
+    #       t_top = x_left · exp( (y_max − y_632) / β )
+    #
+    # ax_top is a hidden twiny() used only for geometry. The actual tick
+    # labels and the yellow band are drawn by draw_band() using fig.text()
+    # in figure-fraction coords so they sit correctly in the thin band
+    # above the top spine regardless of layout changes.
+    # ------------------------------------------------------------------
+    beta_ticks = [0.5, 0.6, 0.7, 0.8, 0.9, 1.0, 1.2, 1.4, 2.0, 3.0, 4.0, 6.0]
+    dy = y_max - y_632  # always positive
+
+    t_tops = {b: x_left * np.exp(dy / b) for b in beta_ticks}
+    visible = [(b, t) for b, t in t_tops.items() if x_left * 1.001 < t < x_right * 0.999]
+
+    ax_top = ax.twiny()
+    ax_top.set_xscale("log")
+    ax_top.set_xlim(x_left, x_right)
+    # Hide ax_top decorations (leaving the shared y-axis alone) to suppress its top x-ticks.
+    # Limits stay tight (0.10-99.9 %) so no stray labels appear.
+    # y-axis left visible: twiny() shares it with ax; hiding it wipes the paper labels.
+    # (no set_yticks([]) here for the same reason)
+    ax_top.set_xticks([])
+    ax_top.set_xlabel("")
+    ax_top.patch.set_visible(False)
+
+    # pad=30: clears the yellow beta band painted above the top spine (band top ~22 pt).
+    ax.set_title(title, fontsize=12, fontweight="bold", pad=30)
+
+    # ------------------------------------------------------------------
+    # draw_band() — must be called by the caller after all plot elements
+    # are added and immediately before fig.savefig().
+    # No tight_layout() should be called between draw_band() and savefig().
+    # ------------------------------------------------------------------
+    fig = ax.get_figure()
+
+    def draw_band() -> None:
+        """Paint the yellow β header band with tick labels and β symbol."""
+        fig.canvas.draw()  # lock layout so get_position() is accurate
+        r = ax.get_position()  # figure-fraction rect of the data axes
+        band_h = 0.028  # thin strip above the top spine
+
+        # Yellow rectangle spanning the full axes width
+        fig.add_artist(
+            plt.Rectangle(
+                (r.x0, r.y1),
+                r.width,
+                band_h,
+                transform=fig.transFigure,
+                facecolor=_BAND_YEL,
+                edgecolor=_BAND_EDGE,
+                linewidth=0.7,
+                zorder=10,
+                clip_on=False,
+            )
+        )
+
+        # β tick labels placed at their geometrically correct x-positions
+        if visible:
+            inv = fig.transFigure.inverted()
+            for b_val, t_val in visible:
+                disp = ax.transData.transform((t_val, y_max))
+                fx, _ = inv.transform(disp)
+                if r.x0 <= fx <= r.x1:
+                    fig.text(
+                        fx,
+                        r.y1 + band_h * 0.50,
+                        f"{b_val:.1f}".rstrip("0").rstrip("."),
+                        transform=fig.transFigure,
+                        fontsize=7.5,
+                        color="purple",
+                        fontweight="bold",
+                        va="center",
+                        ha="center",
+                        zorder=11,
+                    )
+
+        # β symbol shares the right-margin column with the eta label (axes x=1.016), outside the graph
+        fig.text(
+            r.x1 + 0.016 * r.width,
+            r.y1 + band_h * 0.50,
+            "β",
+            transform=fig.transFigure,
+            fontsize=13,
+            fontweight="bold",
+            color="purple",
+            va="center",
+            ha="left",
+            zorder=11,
+        )
+
+    return y_min, y_max, _y, ax_top, draw_band
+
+
+# Backwards-compatibility alias — deprecated shim imports `create_weibull_paper`.
+create_weibull_paper = weibull_probability_paper
+
+
+def plot_weibull_analysis(
+    failure_times,
+    title="Weibull Probability Plot",
+    censored_times=None,
+    method="rry",
+    confidence=0.9,
+):
+    """Create Weibull probability paper with optional suspensions and bootstrap bounds."""
+    fit = fit_weibull(np.asarray(failure_times, dtype=float), censored_times, method=method)
+    plt.switch_backend("Agg")
+
+    beta = fit["beta"]
+    eta = fit["eta"]
+    t_sorted = fit["failure_times"]
+    F = fit["ranks"]
+    censored = fit["censored_times"]
+    bounds = bootstrap_bounds(t_sorted, censored, method=fit["method"], confidence=confidence)
+
+    plt.rcParams["font.family"] = "Arial"
+
+    fig = plt.figure(figsize=(8.5, 11))
+    # Explicit margins — no tight_layout() (which would shift the axes box
+    # after draw_band() computes positions and break the yellow band).
+    gs = GridSpec(
+        nrows=2,
+        ncols=2,
+        figure=fig,
+        width_ratios=[1, 1],
+        height_ratios=[3, 1],
+        top=0.88,  # headroom above axes for band + title
+        bottom=0.10,
+        left=0.13,  # room for 5-char y-axis labels (e.g. "99.90")
+        right=0.93,  # room for η label on the right margin
+        hspace=0.35,
+        wspace=0.3,
+    )
+    ax1 = fig.add_subplot(gs[0, :])
+    ax2 = fig.add_subplot(gs[1, 0])
+    ax3 = fig.add_subplot(gs[1, 1])
+
+    # ------------------------------------------------------------------
+    # Weibull probability paper
+    # ------------------------------------------------------------------
+    x_left = max(float(t_sorted.min()) * 0.5, 1.0)
+    x_right = (
+        max(
+            float(t_sorted.max()),
+            float(np.max(censored)) if len(censored) else 0.0,
+            eta,
+        )
+        * 2.5
+    )
+
+    y_min, y_max, _y, ax_top, draw_band = weibull_probability_paper(ax1, title, x_left, x_right)
+    # Shared top cap: every plotted artist must stay below the top spine so
+    # nothing touches the beta band painted above it (see draw_band).
+    y_632 = _y(63.2)
+    y_end = y_632 + 0.975 * (y_max - y_632)
+
+    # Weibull-linearised y values for the failure data points
+    y_data = np.array([_y(f * 100.0) for f in F])
+
+    # ------------------------------------------------------------------
+    # Plot failure data points
+    # ------------------------------------------------------------------
+    ax1.plot(
+        t_sorted,
+        y_data,
+        "o",
+        markersize=8,
+        color="blue",
+        label="Failures",
+        markerfacecolor="lightblue",
+        markeredgewidth=2,
+        markeredgecolor="blue",
+        zorder=5,
+    )
+
+    # ------------------------------------------------------------------
+    # Plot suspensions (censored times) if any
+    # ------------------------------------------------------------------
+    if len(censored):
+        y_suspensions = np.array([_y(float(weibull_cdf(t, beta, eta)) * 100.0) for t in censored])
+        ax1.plot(
+            censored,
+            y_suspensions,
+            "+",
+            markersize=10,
+            markeredgewidth=2,
+            color="dimgray",
+            label="Suspensions",
+            zorder=4,
+        )
+
+    # ------------------------------------------------------------------
+    # Fitted CDF line
+    # ------------------------------------------------------------------
+    cdf_values = np.linspace(0.001, 0.999, 300)
+    y_fit = np.array([_y(c * 100.0) for c in cdf_values])
+    x_fit = eta * ((-np.log(1 - cdf_values)) ** (1.0 / beta))
+    mask = (x_fit >= x_left) & (x_fit <= x_right) & (y_fit <= y_end)
+    ax1.plot(
+        x_fit[mask],
+        y_fit[mask],
+        color="black",
+        linestyle="-",
+        linewidth=2.0,
+        label="Fitted line",
+        zorder=3,
+    )
+
+    # ------------------------------------------------------------------
+    # Bootstrap confidence band — vectorized (no Python loop over 300 CDFs)
+    # ------------------------------------------------------------------
+    if bounds.get("available"):
+        beta_arr = np.asarray(bounds["samples"]["beta"], dtype=float)
+        eta_arr = np.asarray(bounds["samples"]["eta"], dtype=float)
+        if beta_arr.size > 0 and eta_arr.size > 0:
+            # cdf_values shape (300,); beta/eta shape (samples,)
+            # compute x = eta * (-ln(1-cdf))^(1/beta) for all samples at once
+            log_term = -np.log(1.0 - cdf_values)  # (300,)
+            # outer: (samples, 1) ** (samples,1) broadcast -> (samples, 300)
+            # use exp(log_term / beta) trick via power for stability
+            xs_matrix = eta_arr[:, None] * np.power(log_term[None, :], 1.0 / beta_arr[:, None])
+            alpha = (1.0 - confidence) / 2.0
+            x_low = np.percentile(xs_matrix, 100 * alpha, axis=0)
+            x_high = np.percentile(xs_matrix, 100 * (1.0 - alpha), axis=0)
+            ax1.fill_betweenx(
+                np.minimum(y_fit, y_end),
+                x_low,
+                x_high,
+                color="steelblue",
+                alpha=0.18,
+                label=f"{int(confidence * 100)}% bootstrap band",
+                zorder=2,
+            )
+
+    # ------------------------------------------------------------------
+    # η (scale) crosshairs and marker at 63.2 %
+    # ------------------------------------------------------------------
+    # (y_632 defined above with the paper setup)
+    ax1.axhline(y=y_632, color="green", linestyle="--", linewidth=2, alpha=0.7)
+    ax1.plot(
+        [eta, eta],
+        [y_min, y_end],
+        color="green",
+        linestyle="--",
+        linewidth=2,
+        alpha=0.7,
+    )
+    ax1.plot(
+        eta,
+        y_632,
+        "s",
+        markersize=12,
+        color="green",
+        markeredgewidth=2,
+        markeredgecolor="darkgreen",
+        label=f"η (scale) = {eta:.2f} at 63.2%",
+        zorder=6,
+    )
+
+    # ------------------------------------------------------------------
+    # β reference line — from pivot (x_left, 63.2%) to top of chart.
+    # Slide parallel to the fitted data to read β on the header scale.
+    # ------------------------------------------------------------------
+    # y_end (shared cap above) keeps this line below the top spine.
+    x_end_ref = x_left * np.exp((y_end - y_632) / beta)
+    if x_end_ref <= x_right:
+        ax1.plot(
+            [x_left, x_end_ref],
+            [y_632, y_end],
+            color="purple",
+            linewidth=2.5,
+            linestyle="-.",
+            label=f"β line (pivot → β scale) = {beta:.3f}",
+            zorder=3,
+        )
+
+    # ------------------------------------------------------------------
+    # Stats text box (top-left)
+    # ------------------------------------------------------------------
+    mtbf_value = fit["mtbf"]
+    method_label = "MLE" if fit["method"] == "mle" else "median ranks + rank regression on Y (RRY)"
+    sample_label = (
+        f"{fit['n_failures']} failures, {fit['n_censored']} suspensions"
+        if fit["n_censored"]
+        else f"{fit['n_failures']} failures only"
+    )
+    stats_text = "Weibull parameters\n"
+    stats_text += f"Shape (β): {beta:.3f}\n"
+    stats_text += f"Scale (η): {eta:.2f} hours\n"
+    stats_text += f"MTBF: {mtbf_value:.2f} hours\n"
+    stats_text += f"{sample_label}\n"
+    stats_text += f"Method: {method_label}"
+    if bounds.get("available"):
+        stats_text += f"\nBounds: {int(confidence * 100)}% bootstrap"
+
+    ax1.text(
+        0.02,
+        0.98,
+        stats_text,
+        transform=ax1.transAxes,
+        fontsize=8,
+        verticalalignment="top",
+        bbox=dict(boxstyle="round", facecolor="lightyellow", alpha=0.88),
+        zorder=10,
+    )
+
+    # ------------------------------------------------------------------
+    # Goodness-of-fit text box (bottom-right)
+    # ------------------------------------------------------------------
+    ks_stat, p_value = stats.kstest(
+        t_sorted,
+        lambda x: stats.weibull_min.cdf(x, beta, scale=eta),
+    )
+    fit_text = "Goodness of fit (failures only, informal)\n"
+    fit_text += f"K-S statistic: {ks_stat:.4f}\n"
+    fit_text += f"p-value: {p_value:.4f}"
+    # y=0.25 keeps this box above the lower-right legend even with the
+    # Suspensions entry (legend top sits near axes y=0.19).
+    ax1.text(
+        0.98,
+        0.25,
+        fit_text,
+        transform=ax1.transAxes,
+        fontsize=8,
+        verticalalignment="bottom",
+        horizontalalignment="right",
+        bbox=dict(boxstyle="round", facecolor="lightyellow", alpha=0.88),
+        zorder=10,
+    )
+
+    ax1.legend(loc="lower right", fontsize=8, framealpha=0.9)
+
+    # ------------------------------------------------------------------
+    # Subplot: Probability Density Function (PDF)
+    #
+    # Shows the fitted Weibull PDF with:
+    #   - shaded area under the curve
+    #   - rug plot of actual failure times along the x-axis
+    #   - vertical dashed lines for B10, MTBF (mean), and η (63.2 %)
+    # ------------------------------------------------------------------
+    t_pdf_max = (
+        max(
+            float(t_sorted.max()),
+            float(np.max(censored)) if len(censored) else 0.0,
+            eta,
+        )
+        * 2.0
+    )
+    t_pdf = np.linspace(1e-6, t_pdf_max, 400)
+    pdf_values = stats.weibull_min.pdf(t_pdf, c=beta, scale=eta)
+
+    ax2.plot(t_pdf, pdf_values, color="black", linewidth=1.8, label="Weibull PDF")
+    ax2.fill_between(t_pdf, pdf_values, alpha=0.12, color="steelblue")
+
+    # Rug plot — tick marks at actual failure times
+    ax2.plot(
+        t_sorted,
+        np.zeros_like(t_sorted),
+        "|",
+        color="blue",
+        markersize=8,
+        markeredgewidth=1.5,
+        label="Failure times",
+        clip_on=False,
+    )
+
+    # Reference lines: B10, η (63.2 %), MTBF
+    b10_val = b_life(beta, eta, 10)
+    ref_lines = [
+        (b10_val, "B10", "orangered", "--"),
+        (eta, "η", "green", "-."),
+        (mtbf_value, "MTBF", "steelblue", ":"),
+    ]
+    pdf_peak = pdf_values.max()
+    for t_ref, lbl, col, ls in ref_lines:
+        if t_ref <= t_pdf_max:
+            ax2.axvline(t_ref, color=col, linestyle=ls, linewidth=1.2, alpha=0.85)
+            ax2.text(
+                t_ref,
+                pdf_peak * 0.97,
+                f" {lbl}\n {t_ref:.0f} h",
+                color=col,
+                fontsize=6.5,
+                va="top",
+                ha="left",
+                rotation=90,
+                linespacing=1.3,
+            )
+
+    ax2.set_title("Probability Density (PDF)", fontsize=12, fontweight="bold", pad=5)
+    ax2.set_xlabel("Time in Hours")
+    ax2.set_ylabel("Probability Density")
+    ax2.set_xlim(left=0)
+    ax2.set_ylim(bottom=0)
+    ax2.legend(fontsize=7, loc="upper right")
+    ax2.grid(True, alpha=0.25)
+
+    # ------------------------------------------------------------------
+    # Subplot: Hazard rate
+    # ------------------------------------------------------------------
+    t_grid = np.linspace(
+        max(float(t_sorted.min()) * 0.5, 1e-6),
+        max(
+            float(t_sorted.max()),
+            float(np.max(censored)) if len(censored) else 0.0,
+            eta,
+        ),
+        80,
+    )
+    hazard_function = stats.weibull_min.pdf(t_grid, c=beta, scale=eta) / stats.weibull_min.sf(
+        t_grid, c=beta, scale=eta
+    )
+    ax3.plot(t_grid, hazard_function, color="black", linewidth=1.5)
+    ax3.set_title("Hazard Rate (Trend)", fontsize=12, fontweight="bold", pad=5)
+    ax3.set_xlabel("Time in Hours")
+    ax3.set_ylabel("Hazard Function")
+
+    # ------------------------------------------------------------------
+    # Finalise: draw the β band THEN save.
+    # No tight_layout() — explicit GridSpec margins are used instead so
+    # the band position computed in draw_band() is stable.
+    # ------------------------------------------------------------------
+    draw_band()
+
+    STATIC_DIR.mkdir(parents=True, exist_ok=True)
+    save_path = str(
+        plot_path_for(
+            "weibull_plot",
+            sorted(map(float, np.ravel(failure_times))),
+            sorted(map(float, np.ravel(censored_times))) if censored_times is not None else [],
+            method,
+            confidence,
+            title,
+        )
+    )
+    fig.savefig(save_path, dpi=150)
+    plt.close(fig)
+
+    payload = {
+        "file": save_path,
+        "beta": beta,
+        "eta": eta,
+        "mtbf": mtbf_value,
+        "ks_stat": ks_stat,
+        "p_value": p_value,
+        "method": fit["method"],
+        "n_failures": fit["n_failures"],
+        "n_censored": fit["n_censored"],
+        "b10": b_life(beta, eta, 10),
+        "b20": b_life(beta, eta, 20),
+        "b30": b_life(beta, eta, 30),
+        "confidence": confidence,
+        "message": f"Weibull plot saved as {save_path}",
+    }
+    if bounds.get("available"):
+        payload["bounds"] = {
+            "method": bounds["bound_method"],
+            "confidence": bounds["confidence"],
+            "beta": bounds["beta"],
+            "eta": bounds["eta"],
+            "b10": bounds["b10"],
+            "b20": bounds["b20"],
+        }
+    return payload
+
