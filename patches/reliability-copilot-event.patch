+++ b/backend/tests/test_thinking.py
@@ -0,0 +1,77 @@
+"""Scaffolding-dialect filter: control tokens/headers route to thought."""
+
+from src.host.thinking import StreamThoughtSplitter, split_thinking_from_answer
+
+SAMPLE = (
+    "<|start|>assistant to=commentary<|message|>Your censored dataset is ready."
+    "<|eom|><|start|>assistant to=analyze_weibull<|message|>"
+    'Action: analyze_weibull Action Input: {"objective": "Assess", "units": "hours"}'
+    "<|eot|>Thought: The current language of the user is English. I must call a tool."
+)
+
+
+def test_full_split_hides_scaffolding_dialect():
+    thought, answer = split_thinking_from_answer(SAMPLE)
+    assert "<|" not in thought and "<|" not in answer
+    assert "assistant to=" not in thought and "assistant to=" not in answer
+    assert "analyze_weibull" in thought
+    assert "Thought:" in thought
+    assert answer == "Your censored dataset is ready."
+
+
+def test_repeated_commentary_collapses_to_one():
+    thought, answer = split_thinking_from_answer(SAMPLE + SAMPLE + SAMPLE)
+    assert answer == "Your censored dataset is ready."
+    assert "<|" not in thought
+
+
+def test_lone_action_prose_stays_in_answer():
+    text = "Action: replace the seal and retest before quoting life."
+    thought, answer = split_thinking_from_answer(text)
+    assert thought == ""
+    assert answer == text
+
+
+def test_classic_leading_thought_still_hidden():
+    thought, answer = split_thinking_from_answer(
+        "Thought: let me think\nFinal Answer: B10 is 325 hours."
+    )
+    assert "let me think" in thought
+    assert answer == "B10 is 325 hours."
+
+
+def test_plain_text_untouched():
+    text = "The B10 life is 325 hours with 90% confidence."
+    assert split_thinking_from_answer(text) == ("", text)
+
+
+def _stream(text, chunk=7):
+    splitter = StreamThoughtSplitter()
+    events = []
+    for i in range(0, len(text), chunk):
+        events.extend(splitter.feed(text[i : i + chunk]))
+    events.extend(splitter.flush())
+    return events
+
+
+def test_streaming_never_emits_scaffolding_as_answer():
+    events = _stream(SAMPLE + SAMPLE)
+    tokens = "".join(t for kind, t in events if kind == "token")
+    assert "<|" not in tokens
+    assert "assistant to=" not in tokens
+    assert "Thought:" not in tokens
+    assert "Action:" not in tokens
+    assert tokens.count("Your censored dataset is ready.") == 1
+
+
+def test_streaming_holds_split_tokens_and_headers():
+    events = _stream(SAMPLE, chunk=3)
+    joined = "".join(t for _, t in events)
+    assert "entary" not in joined  # split `commentary` header must not leak
+    assert "<|" not in joined
+
+
+def test_streaming_mid_answer_thought_without_dialect_stays():
+    events = _stream("The result is 5.\nThought: hmm\nMore text here.")
+    tokens = "".join(t for kind, t in events if kind == "token")
+    assert "Thought: hmm" in tokens
