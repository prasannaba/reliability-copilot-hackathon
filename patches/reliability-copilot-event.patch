+        [_FakeToolCall("fit_weibull"), first, _FakeToolCall("kaplan_meier"), second]
+    )
+    images = [e["url"] for e in events if e["type"] == "image"]
+    assert images == ["/static/fit.png", "/static/km.png"]
+    done = [e for e in events if e["type"] == "done"]
+    assert len(done) == 1
+    assert done[0]["image_urls"] == ["/static/fit.png", "/static/km.png"]
+    assert done[0]["image_url"] == "/static/km.png"
+
+@needs_loop
+def test_stream_done_without_plots_has_empty_image_list(tmp_path, monkeypatch):
+    import src.host.app as host_app
+
+    monkeypatch.setattr(host_app, "STATIC_DIR", tmp_path)
+    events = _run_stream([_FakeToolCall("ask"), _FakeToolCallResult("ask")])
+    done = [e for e in events if e["type"] == "done"]
+    assert len(done) == 1
+    assert done[0]["image_urls"] == []
+    assert done[0]["image_url"] is None
+    assert [e for e in events if e["type"] == "image"] == []
+
+def test_kb_skipped_only_for_non_wh_followups_with_context():
+    from src.host.app import _skip_kb_for_followup
+
+    hist = [
+        ChatMessage(role="user", content="Fit Weibull to 100..600 hours"),
+        ChatMessage(role="assistant", content="β = 1.72. Plot: `weibull_plot_abc123.png`."),
+    ]
+    # WH-questions keep retrieval (and citations) even with context.
+    assert not _skip_kb_for_followup("Why 63.2%?", hist)
+    assert not _skip_kb_for_followup("Why can't we use normal distribution here?", hist)
+    # Confirmations and context-bound follow-ups run from transcript+ledger.
+    assert _skip_kb_for_followup("So we need more failure data?", hist)
+    assert _skip_kb_for_followup("Compare the analysis", hist)
+    # No established context: never skip.
+    assert not _skip_kb_for_followup("Why normal?", ())
+    assert not _skip_kb_for_followup("Fit Weibull to 150, 180, 220", ())
+@needs_loop
+def test_missing_claim_without_context_is_delivered():
+    # Without false_claim detection, semantic violations are not enforced at the code level.
+    # The system prompt handles this. This test verifies the agent is not repaired
+    # for semantic violations - the prompt is trusted for this.
