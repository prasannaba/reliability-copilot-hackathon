--- /dev/null
+++ b/frontend/src/hooks/usePromptHistory.ts
@@ -0,0 +1,86 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import type { Message } from "../types/chat";
+
+/**
+ * Per-session prompt history browsed with Up/Down in the composer.
+ *
+ * Derived from that session's user messages (in-memory, no extra storage).
+ * Consecutive duplicate prompts are collapsed. While browsing, the caller's
+ * current draft is saved and restored when the user scrolls past the newest
+ * entry.
+ */
+export function usePromptHistory(messages: Message[]) {
+  const history = useMemo(() => {
+    const out: string[] = [];
+    for (const m of messages) {
+      if (m.role !== "user") continue;
+      const text = m.content.trim();
+      if (!text) continue;
+      if (out.length && out[out.length - 1] === text) continue;
+      out.push(text);
+    }
+    return out;
+  }, [messages]);
+
+  // null = not browsing history; otherwise index into `history` (0 = oldest).
+  const [cursor, setCursor] = useState<number | null>(null);
+  const [draft, setDraft] = useState("");
+  const resetKey = history.length;
+
+  useEffect(() => {
+    setCursor(null);
+    setDraft("");
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [resetKey]);
+
+  const reset = useCallback(() => {
+    setCursor(null);
+    setDraft("");
+  }, []);
+
+  const draftRef = useRef(draft);
+  draftRef.current = draft;
+
+  const move = useCallback(
+    (
+      direction: "up" | "down",
+      currentInput: string,
+    ): { nextValue: string; nextCursor: number | null; didHandle: boolean } => {
+      if (!history.length) {
+        return { nextValue: currentInput, nextCursor: null, didHandle: false };
+      }
+      if (direction === "up") {
+        if (cursor === null) {
+          setDraft(currentInput);
+          const nextIdx = history.length - 1;
+          setCursor(nextIdx);
+          return { nextValue: history[nextIdx], nextCursor: nextIdx, didHandle: true };
+        }
+        if (cursor > 0) {
+          const nextIdx = cursor - 1;
+          setCursor(nextIdx);
+          return { nextValue: history[nextIdx], nextCursor: nextIdx, didHandle: true };
+        }
+        return { nextValue: history[cursor], nextCursor: cursor, didHandle: true };
+      }
+      if (cursor === null) {
+        return { nextValue: currentInput, nextCursor: null, didHandle: false };
+      }
+      if (cursor < history.length - 1) {
+        const nextIdx = cursor + 1;
+        setCursor(nextIdx);
+        return { nextValue: history[nextIdx], nextCursor: nextIdx, didHandle: true };
+      }
+      const restored = draftRef.current;
+      setCursor(null);
+      return { nextValue: restored, nextCursor: null, didHandle: true };
+    },
+    [cursor, history],
+  );
+
+  const onEdited = useCallback(() => {
+    if (cursor !== null) setCursor(null);
+  }, [cursor]);
+
+  return { history, cursor, draft, move, reset, onEdited } as const;
+}
