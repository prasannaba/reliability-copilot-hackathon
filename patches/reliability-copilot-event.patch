index 0000000000000000000000000000000000000000..3af70e039cda0ee660f7731b9b58dd99e40f5d69
--- /dev/null
+++ b/backend/src/domains/reliability/nonparametric.py
@@ -0,0 +1,127 @@
+"""Non-parametric life-data estimation: Kaplan-Meier + Nelson-Aalen.
+
+Distribution-free empirical reference (NIST/SEMATECH e-Handbook 8.2.1.5) used
+to guide parametric distribution selection without assuming a family.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import numpy as np
+
+# Slope of log H vs log t outside this band counts as increasing/decreasing
+# hazard (rule-of-thumb cue, reported as supporting evidence only).
+_SHAPE_BAND = 0.15
+
+_Z_95 = 1.96
+
+
+def _validate(
+    failure_times: list[float] | tuple[float, ...] | np.ndarray,
+    censored_times: list[float] | tuple[float, ...] | np.ndarray | None,
+) -> tuple[np.ndarray, np.ndarray]:
+    failures = np.asarray(failure_times, dtype=float)
+    censored = np.asarray(
+        censored_times if censored_times is not None else [], dtype=float
+    )
+    if failures.size == 0:
+        raise ValueError("at least one failure time is required")
+    if not np.all(np.isfinite(failures)) or np.any(failures <= 0):
+        raise ValueError("failure times must be finite and greater than zero")
+    if censored.size and (not np.all(np.isfinite(censored)) or np.any(censored < 0)):
+        raise ValueError("censored times must be finite and zero or greater")
+    return failures, censored
+
+
+def kaplan_meier(
+    failure_times: list[float] | tuple[float, ...] | np.ndarray,
+    censored_times: list[float] | tuple[float, ...] | np.ndarray | None = None,
+) -> dict[str, Any]:
+    """Kaplan-Meier product-limit survival curve with Greenwood bounds.
+
+    Ties: at each distinct event time, failures apply first (d/n), then
+    suspensions are removed from the risk set.
+    """
+    failures, censored = _validate(failure_times, censored_times)
+
+    events: dict[float, list[int]] = {}
+    for t in failures:
+        events.setdefault(float(t), [0, 0])[0] += 1
+    for t in censored:
+        events.setdefault(float(t), [0, 0])[1] += 1
+
+    times: list[float] = []
+    survival: list[float] = []
+    variance: list[float] = []
+    at_risk = int(failures.size + censored.size)
+    surv, greenwood_sum = 1.0, 0.0
+    for t in sorted(events):
+        deaths, suspensions = events[t]
+        if deaths:
+            surv *= (at_risk - deaths) / at_risk
+            if surv > 0 and at_risk > deaths:
+                greenwood_sum += deaths / (at_risk * (at_risk - deaths))
+        at_risk -= deaths + suspensions
+        times.append(t)
+        survival.append(surv)
+        variance.append(surv**2 * greenwood_sum)
+
+    times_arr = np.asarray(times)
+    surv_arr = np.asarray(survival)
+    se = np.sqrt(np.asarray(variance))
+    lower = np.clip(surv_arr - _Z_95 * se, 0.0, 1.0)
+    upper = np.clip(surv_arr + _Z_95 * se, 0.0, 1.0)
+
+    below = np.nonzero(surv_arr <= 0.5)[0]
+    median = float(times_arr[below[0]]) if below.size else None
+
+    # Nelson-Aalen cumulative hazard H(t) = cumsum(d/n).
+    hazard: list[float] = []
+    cumulative = 0.0
+    at_risk = int(failures.size + censored.size)
+    for t in sorted(events):
+        deaths, suspensions = events[t]
+        if deaths:
+            cumulative += deaths / at_risk
+        at_risk -= deaths + suspensions
+        hazard.append(cumulative)
+    hazard_arr = np.asarray(hazard)
+
+    shape_cue = _hazard_shape_cue(times_arr, hazard_arr)
+
+    return {
+        "times": times_arr.tolist(),
+        "survival": surv_arr.tolist(),
+        "ci_lower": lower.tolist(),
+        "ci_upper": upper.tolist(),
+        "ci_method": "Greenwood standard error, normal 95% interval clipped to [0, 1]",
+        "median": median,
+        "cumulative_hazard": hazard_arr.tolist(),
+        "hazard_shape_cue": shape_cue,
+        "n_failures": int(failures.size),
+        "n_censored": int(censored.size),
+    }
+
+
+def _hazard_shape_cue(times: np.ndarray, hazard: np.ndarray) -> dict[str, Any]:
+    """Slope of log H on log t as a distribution-selection cue.
+
+    For Weibull data, H(t) = (t/eta)^beta, so the slope estimates beta's
+    position relative to 1 (increasing / constant / decreasing hazard).
+    Reported as supporting evidence only — never a fit.
+    """
+    positive = (times > 0) & (hazard > 0)
+    slope: float | None = None
+    if int(np.count_nonzero(positive)) >= 3:
+        with np.errstate(all="ignore"):
+            slope = float(np.polyfit(np.log(times[positive]), np.log(hazard[positive]), 1)[0])
+    if slope is None or not np.isfinite(slope):
+        label = "undetermined"
+    elif slope > 1.0 + _SHAPE_BAND:
+        label = "increasing"
+    elif slope < 1.0 - _SHAPE_BAND:
+        label = "decreasing"
+    else:
+        label = "approximately-constant"
+    return {"slope": slope, "hazard": label}
