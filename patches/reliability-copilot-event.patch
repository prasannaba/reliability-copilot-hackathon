+    expect(imgs[1].getAttribute('src')).toBe('/static/km.png');
+  });
+
+  it('falls back to the legacy single imageUrl', () => {
+    const { container } = renderItem(
+      assistantMessage({ imageUrl: '/static/only.png' }),
+      false,
+      false,
+    );
+    expect(container.querySelectorAll('img.chat-image')).toHaveLength(1);
+  });
+
+  it('renders no plot when none attached', () => {
+    const { container } = renderItem(assistantMessage({}), false, false);
+    expect(container.querySelector('img.chat-image')).toBeNull();
+  });
+
+  it('opens a lightbox with download on double click, closes on Escape', () => {
+    const { container } = renderItem(
+      assistantMessage({ imageUrls: ['/static/fit.png'] }),
+      false,
+      false,
+    );
+    const img = container.querySelector('img.chat-image');
+    if (!img) throw new Error('expected plot image');
+    fireEvent.doubleClick(img);
+    const dialog = screen.getByRole('dialog', { name: 'Enlarged plot' });
+    fireEvent.click(within(dialog).getByText('Download plot'));
+    expect(callbacks.onDownloadPlot).toHaveBeenCalledWith('/static/fit.png');
+    fireEvent.keyDown(document, { key: 'Escape' });
+    expect(screen.queryByRole('dialog', { name: 'Enlarged plot' })).toBeNull();
+  });
+});
+
+describe('streaming display', () => {
+  it('shows raw text while streaming instead of rich markdown', () => {
+    const { container } = renderItem(
+      assistantMessage({ content: '**bold** and $x=y+1$ math' }),
+      true,
+      true,
+      true,
+    );
+    expect(container.querySelector('.assistant-plain')?.textContent).toContain('**bold**');
+    expect(container.textContent).toContain('$x=y+1$');
+    expect(container.querySelector('.assistant-markdown')).toBeNull();
+    expect(container.querySelector('.katex')).toBeNull();
+  });
+
+  it('renders rich markdown once streaming finishes', () => {
+    const { container } = renderItem(
+      assistantMessage({ content: '**bold** and $x=y+1$ math' }),
+      true,
+      false,
+      false,
+    );
+    expect(container.querySelector('.assistant-markdown strong')?.textContent).toBe('bold');
+    expect(container.querySelector('.katex')).not.toBeNull();
+    expect(container.textContent).not.toContain('$x=y+1$');
+  });
+});
+
+describe('katex math', () => {
+  it('renders math declaratively with no raw delimiters once done', () => {
+    const { container } = renderItem(
+      assistantMessage({ content: 'Result $x=y+1$ done' }),
+      false,
+      false,
+    );
+    expect(container.querySelector('.katex')).not.toBeNull();
+    expect(container.textContent).not.toContain('$x=y+1$');
+  });
+
+  it('keeps KaTeX positioning styles through sanitization', () => {
+    const { container } = renderItem(
+      assistantMessage({ content: 'Weibull $B_{10} = 129.9$ hours.' }),
+      false,
+      false,
+    );
+    // KaTeX positions sub/superscripts and fractions with inline styles;
+    // a sanitize pass running after KaTeX would strip them and collapse
+    // the layout (subscript 10 dropping below the B).
+    expect(container.querySelector('.katex [style]')).not.toBeNull();
+  });
+
+  it('renders model sb subscripts as real subscripts, never errors', () => {
+    const { container } = renderItem(
+      assistantMessage({ content: 'Weibull $B\\sb{10} = 129.9$ hours.' }),
+      false,
+      false,
+    );
+    expect(container.querySelector('.katex-error')).toBeNull();
+    expect(container.querySelector('.katex .msupsub')).not.toBeNull();
+  });
+
+  it('still strips raw HTML styles from the message source', () => {
+    const { container } = renderItem(
+      assistantMessage({
+        content: '<span style="position:fixed">hi</span> after',
+      }),
+      false,
+      false,
+    );
+    expect(container.querySelector('[style]')).toBeNull();
+  });
+});
