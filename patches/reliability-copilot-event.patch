diff --git a/backend/src/domains/reliability/tools/life_table.py b/backend/src/domains/reliability/tools/life_table.py
new file mode 100644
index 0000000000000000000000000000000000000000..ae6ae53944c417d335c7a8d7c468e5cec41d6d57
--- /dev/null
+++ b/backend/src/domains/reliability/tools/life_table.py
@@ -0,0 +1,139 @@
+"""Deterministic parsing of pasted life-data tables (plain fn; registered in server.py).
+
+LLMs must never expand a Frequency column by hand: the parsed arrays from
+this tool are the single source of truth for every downstream fit.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+_TIME_NAMES = {"time", "t", "times", "life", "lives", "failuretime", "failuretimes"}
+_CENSORED_NAMES = {"censored", "cens", "censor", "c", "suspension", "suspensions", "suspended", "susp"}
+_FREQUENCY_NAMES = {"frequency", "freq", "f", "count", "counts", "n", "number", "weight"}
+
+#: Hard cap on expanded units: a typo like Frequency=1000000 must fail loudly.
+_MAX_UNITS = 100_000
+
+
+def _split_row(line: str) -> list[str]:
+    """Split one table row on pipes, tabs, semicolons, commas, or whitespace."""
+    text = line.strip().strip("|").strip()
+    for separator in ("|", "\t", ";"):
+        if separator in text:
+            return [cell.strip() for cell in text.split(separator)]
+    if "," in text:
+        return [cell.strip() for cell in text.split(",")]
+    return text.split()
+
+
+def _is_number(cell: str) -> bool:
+    try:
+        float(cell)
+        return True
+    except (TypeError, ValueError):
+        return False
+
+
+def _stem(cell: str) -> str:
+    return re.sub(r"[^a-z]", "", cell.lower())
+
+
+def _classify(header: list[str]) -> dict[str, int]:
+    """Map header cells to roles; raises ValueError on anything ambiguous."""
+    roles: dict[str, int] = {}
+    for index, cell in enumerate(header):
+        stem = _stem(cell)
+        if not stem:
+            continue
+        if stem in _TIME_NAMES:
+            role = "time"
+        elif stem in _CENSORED_NAMES:
+            role = "censored"
+        elif stem in _FREQUENCY_NAMES:
+            role = "frequency"
+        else:
+            raise ValueError(
+                f"unrecognized column '{cell}': expected Time, Censored (0/1), "
+                "and optional Frequency headers"
+            )
+        if role in roles:
+            raise ValueError(f"duplicate '{cell}' column: each role may appear once")
+        roles[role] = index
+    missing = {"time", "censored"} - set(roles)
+    if missing:
+        raise ValueError(
+            f"missing required column(s) {sorted(missing)}: expected Time, "
+            "Censored (0/1), and optional Frequency headers"
+        )
+    return roles
+
+
+def parse_life_data_table(table: str) -> dict[str, Any]:
+    """Parse a pasted life-data table into validated failure/suspension arrays.
+
+    Accepts markdown, CSV, TSV, or whitespace-separated tables with Time,
+    Censored (0 = failed, 1 = right-suspended), and optional Frequency
+    columns; a header row is optional (positional Time, Censored, Frequency).
+    Frequency rows are expanded deterministically so n_units always equals
+    the stated sample size. Raises ValueError naming the exact bad row.
+    """
+    if not (table or "").strip():
+        raise ValueError("no table provided: paste Time/Censored/Frequency rows")
+    lines = [line for line in str(table).splitlines() if line.strip() and not re.fullmatch(r"\s*\|?[\s:|-]+\|?\s*", line)]
+    if not lines:
+        raise ValueError("no data rows found in table")
+    first = _split_row(lines[0])
+    if any(not _is_number(cell) for cell in first if cell):
+        roles = _classify(first)
+        data_lines = lines[1:]
+    else:
+        if len(first) == 2:
+            roles = {"time": 0, "censored": 1}
+        elif len(first) == 3:
+            roles = {"time": 0, "censored": 1, "frequency": 2}
+        else:
+            raise ValueError(
+                "headerless tables need 2 columns (Time, Censored) or 3 "
+                "(Time, Censored, Frequency)"
+            )
+        data_lines = lines
+    if not data_lines:
+        raise ValueError("no data rows found in table")
+    width = max(len(_split_row(line)) for line in data_lines)
+    if max(roles.values()) >= width:
+        raise ValueError("a data row is narrower than the header: check column alignment")
+
+    failures: list[float] = []
+    censored: list[float] = []
+    for row_number, line in enumerate(data_lines, start=1):
+        cells = _split_row(line)
+        try:
+            moment = float(cells[roles["time"]])
+            flag = float(cells[roles["censored"]])
+            repeats = float(cells[roles["frequency"]]) if "frequency" in roles else 1.0
+        except (IndexError, ValueError):
+            raise ValueError(f"row {row_number}: all cells must be numeric") from None
+        if moment < 0 or (flag == 0 and moment <= 0):
+            raise ValueError(f"row {row_number}: times must be >= 0 (failures > 0)")
+        if flag not in (0.0, 1.0):
+            raise ValueError(f"row {row_number}: censored flag must be 0 or 1, got {cells[roles['censored']]}")
+        if not repeats.is_integer() or repeats < 1:
+            raise ValueError(f"row {row_number}: frequency must be a positive integer")
+        target = failures if flag == 0.0 else censored
+        target.extend([moment] * int(repeats))
+        if len(failures) + len(censored) > _MAX_UNITS:
+            raise ValueError(f"expansion exceeds {_MAX_UNITS} units: check the Frequency column")
+
+    if not failures:
+        raise ValueError("no failures found: at least one row needs Censored = 0")
+    n_failures, n_censored = len(failures), len(censored)
+    return {
+        "failure_times": failures,
+        "censored_times": censored,
+        "n_units": n_failures + n_censored,
+        "n_failures": n_failures,
+        "n_censored": n_censored,
+        "message": f"Parsed {n_failures + n_censored} units: {n_failures} failures + {n_censored} suspensions.",
+    }
