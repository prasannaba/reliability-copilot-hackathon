+"""Deterministic plot filenames: same inputs reuse one file, never pile up."""
+
+import sys
+from pathlib import Path
+
+sys.path.append(str(Path(__file__).resolve().parents[1]))
+
+from src.domains.reliability import growth_plot, plotting
+
+
+def _km_dict(times=(100.0, 200.0, 300.0)):
+    import numpy as np
+
+    times = np.asarray(times, dtype=float)
+    return {
+        "times": times,
+        "survival": np.array([0.9, 0.6, 0.3]),
+        "ci_lower": np.array([0.8, 0.5, 0.2]),
+        "ci_upper": np.array([1.0, 0.7, 0.4]),
+        "median": 250.0,
+    }
+
+
+def test_weibull_plot_reuses_file_for_same_inputs(tmp_path, monkeypatch):
+    monkeypatch.setattr(plotting, "STATIC_DIR", tmp_path)
+    first = plotting.plot_weibull_analysis([54, 187, 240], censored_times=[500, 500])
+    second = plotting.plot_weibull_analysis([54, 187, 240], censored_times=[500, 500])
+    assert first["file"] == second["file"]
+    assert Path(first["file"]).is_file()
+    assert Path(first["file"]).name.startswith("weibull_plot_")
+
+
+def test_weibull_plot_changes_file_for_new_inputs(tmp_path, monkeypatch):
+    monkeypatch.setattr(plotting, "STATIC_DIR", tmp_path)
+    first = plotting.plot_weibull_analysis([54, 187, 240])
+    second = plotting.plot_weibull_analysis([54, 187, 300])
+    assert first["file"] != second["file"]
+
+
+def test_km_and_comparison_plots_reuse_files(tmp_path, monkeypatch):
+    monkeypatch.setattr(plotting, "STATIC_DIR", tmp_path)
+    km = _km_dict()
+    assert plotting.plot_kaplan_meier(km)["file"] == plotting.plot_kaplan_meier(km)["file"]
+    fits = [{"family": "weibull", "params": {"beta": 2.0, "eta": 300.0}, "aic": 100.0}]
+    first = plotting.plot_distribution_comparison(km, fits)
+    second = plotting.plot_distribution_comparison(km, fits)
+    assert first["file"] == second["file"]
+    assert Path(first["file"]).is_file()
+
+
+def test_eda_and_growth_plots_reuse_files(tmp_path, monkeypatch):
+    monkeypatch.setattr(plotting, "STATIC_DIR", tmp_path)
+    monkeypatch.setattr(growth_plot, "STATIC_DIR", tmp_path)
+    assert (
+        plotting.plot_eda_4plot([54, 187, 240, 335])["file"]
+        == plotting.plot_eda_4plot([54, 187, 240, 335])["file"]
+    )
+    first = growth_plot.plot_growth_analysis([10, 25, 60, 120, 250])
+    second = growth_plot.plot_growth_analysis([10, 25, 60, 120, 250])
+    assert first["file"] == second["file"]
+    assert Path(first["file"]).is_file()
