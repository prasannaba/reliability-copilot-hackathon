index 0000000000000000000000000000000000000000..f7889f28bdf8c4c7a6502dcdf3182e90516154ad
--- /dev/null
+++ b/backend/src/domains/reliability/planning.py
@@ -0,0 +1,155 @@
+"""Reliability planning calculations: warranty forecast + demonstration tests.
+
+Both functions are deterministic and assumption-explicit: the LLM never
+estimates these values. The warranty forecast treats fielded units as
+independent draws from one fitted Weibull life distribution. The
+demonstration-test plan is the classical zero-failure (success-run) plan
+under an assumed, known Weibull shape parameter.
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Any
+
+import numpy as np
+from scipy.stats import binom
+
+
+def _positive_finite(name: str, value: float) -> float:
+    out = float(value)
+    if not math.isfinite(out) or out <= 0:
+        raise ValueError(f"{name} must be positive and finite")
+    return out
+
+
+def _probability(name: str, value: float) -> float:
+    out = float(value)
+    if not math.isfinite(out) or not 0.0 < out < 1.0:
+        raise ValueError(f"{name} must be between 0 and 1 (exclusive)")
+    return out
+
+
+def _units(units: str) -> str:
+    out = str(units or "").strip()
+    if not out:
+        raise ValueError("units must be a non-empty time unit (e.g. 'hours')")
+    return out
+
+
+def warranty_failure_forecast(
+    beta: float,
+    eta: float,
+    warranty_time: float,
+    population: int,
+    confidence: float = 0.90,
+    units: str = "hours",
+) -> dict[str, Any]:
+    """Expected warranty failures for a fielded population.
+
+    With Weibull CDF ``F(t) = 1 - exp(-(t/eta)**beta)``, each of the
+    ``population`` independent units fails by ``warranty_time`` with
+    probability ``F(warranty_time)``; the failure count is therefore
+    Binomial(population, F). Returns the mean count and the central
+    ``confidence`` binomial interval.
+    """
+    beta = _positive_finite("beta", beta)
+    eta = _positive_finite("eta", eta)
+    warranty_time = _positive_finite("warranty_time", warranty_time)
+    confidence = _probability("confidence", confidence)
+    units = _units(units)
+    if int(population) != population or int(population) <= 0:
+        raise ValueError("population must be a positive whole number")
+    population = int(population)
+
+    reliability = float(np.exp(-((warranty_time / eta) ** beta)))
+    failure_probability = 1.0 - reliability
+    expected = population * failure_probability
+    alpha = (1.0 - confidence) / 2.0
+    lower = int(binom.ppf(alpha, population, failure_probability))
+    upper = int(binom.ppf(1.0 - alpha, population, failure_probability))
+    return {
+        "beta": beta,
+        "eta": eta,
+        "warranty_time": warranty_time,
+        "units": units,
+        "population": population,
+        "reliability_at_warranty": reliability,
+        "failure_probability_by_warranty": failure_probability,
+        "expected_failures": float(expected),
+        "failure_count_interval": [lower, upper],
+        "confidence": confidence,
+        "method": "Weibull CDF at warranty_time; Binomial(population, F) mean and central interval",
+        "assumptions": [
+            "Units are independent and share the fitted Weibull(beta, eta) life distribution",
+            "Every unit accumulates warranty_time of exposure (no staggered entry or early removal)",
+            "beta/eta come from a fit tool; uncertainty in beta/eta is not propagated into this interval",
+        ],
+    }
+
+
+def demonstration_test_plan(
+    target_reliability: float,
+    confidence: float,
+    assumed_beta: float,
+    mission_time: float,
+    sample_size: int | None = None,
+    test_duration: float | None = None,
+    units: str = "hours",
+) -> dict[str, Any]:
+    """Zero-failure (success-run) demonstration test plan.
+
+    To demonstrate reliability ``R`` at ``mission_time`` with confidence
+    ``C`` when the Weibull shape ``beta`` is assumed known, testing ``n``
+    units for ``t`` each with zero failures satisfies
+
+        C = 1 - R ** (n * (t / mission_time) ** beta)
+
+    Exactly one of ``sample_size`` / ``test_duration`` must be given; the
+    other is solved for.
+    """
+    target_reliability = _probability("target_reliability", target_reliability)
+    confidence = _probability("confidence", confidence)
+    assumed_beta = _positive_finite("assumed_beta", assumed_beta)
+    mission_time = _positive_finite("mission_time", mission_time)
+    units = _units(units)
+    if (sample_size is None) == (test_duration is None):
+        raise ValueError("provide exactly one of sample_size or test_duration")
+
+    log_ratio = math.log(1.0 - confidence) / math.log(target_reliability)  # > 0
+    if test_duration is not None:
+        duration = _positive_finite("test_duration", test_duration)
+        ratio = duration / mission_time
+        exact_n = log_ratio / (ratio**assumed_beta)
+        n = max(1, math.ceil(exact_n))
+        mode = "required_sample_size"
+    else:
+        if int(sample_size) != sample_size or int(sample_size) <= 0:  # type: ignore[arg-type]
+            raise ValueError("sample_size must be a positive whole number")
+        n = int(sample_size)  # type: ignore[arg-type]
+        ratio = (log_ratio / n) ** (1.0 / assumed_beta)
+        duration = ratio * mission_time
+        exact_n = float(n)
+        mode = "required_test_duration"
+
+    achieved = 1.0 - target_reliability ** (n * (duration / mission_time) ** assumed_beta)
+    return {
+        "mode": mode,
+        "target_reliability": target_reliability,
+        "confidence": confidence,
+        "achieved_confidence": float(achieved),
+        "assumed_beta": assumed_beta,
+        "mission_time": mission_time,
+        "test_duration": float(duration),
+        "sample_size": n,
+        "units": units,
+        "zero_failures_allowed": 0,
+        "method": "Zero-failure success run: C = 1 - R^(n*(t/mission_time)^beta), solved for the requested unknown",
+        "assumptions": [
+            "Weibull shape (assumed_beta) is known/assumed; only the scale is being demonstrated",
+            "Units are independent and identical, each tested for the full test_duration",
+            "The plan succeeds only with zero failures; one failure invalidates the demonstration",
+            f"Demonstrated claim is reliability >= {target_reliability} at {mission_time} {units}, not a fitted life estimate",
+        ],
+        "exact_sample_size_before_rounding": float(exact_n),
+    }
