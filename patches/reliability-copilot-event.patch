+        ChatMessage(role="user", content="Fit Weibull to 100..600 hours"),
+        ChatMessage(role="assistant", content="β = 1.72. Plot: `weibull_plot_abc123.png`."),
+    ]
+    # "Why 63.2%?" carries numbers but is a conceptual question about the
+    # established analysis, not a new data payload — it must not escalate
+    # to the full compute contract (the turn-4 lecture bug).
+    out = build_augmented_prompt("Why 63.2%?", "", hist)
+    assert "Follow-up behavior" not in out
+    assert "Agent behavior:" not in out
+    assert "User: Fit Weibull" in out
