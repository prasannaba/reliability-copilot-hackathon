+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { cleanup, fireEvent, render, screen, within } from '@testing-library/react';
+import { MessageItem } from './MessageItem';
+import type { Message } from '../types/chat';
+
+afterEach(cleanup);
+
+const callbacks = {
+  onCopy: vi.fn(),
+  onStartEdit: vi.fn(),
+  onEditingChange: vi.fn(),
+  onSaveEdit: vi.fn(),
+  onCancelEdit: vi.fn(),
+  onRegenerate: vi.fn(),
+  onDownloadPlot: vi.fn(),
+};
+
+function assistantMessage(overrides: Partial<Message> = {}): Message {
+  return {
+    id: 'm1',
+    role: 'assistant',
+    content: 'B10 is 325 hours.',
+    timestamp: Date.now(),
+    toolTrail: [
+      { name: 'search_reliability_knowledge', done: true },
+      { name: 'analyze_weibull', done: false },
+    ],
+    thinkingText: 'secret reasoning prose',
+    ...overrides,
+  };
+}
+
+function renderItem(msg: Message, isLast: boolean, isLoading: boolean, streaming = false) {
+  return render(
+    <MessageItem
+      msg={msg}
+      isLast={isLast}
+      isLoading={isLoading}
+      streaming={streaming}
+      selectedModel=""
+      copied={false}
+      editing={false}
+      editingContent=""
+      {...callbacks}
+    />,
+  );
+}
+
+describe('progress trail', () => {
+  it('shows friendly step names while running, never thinking prose', () => {
+    const { container } = renderItem(assistantMessage(), true, true);
+    const trail = screen.getByRole('list', { name: 'Analysis progress' });
+    expect(within(trail).getByText('Searched knowledge base')).toBeTruthy();
+    expect(within(trail).getByText('Fit Weibull distribution')).toBeTruthy();
+    expect(container.textContent).not.toContain('secret reasoning prose');
+    expect(container.querySelector('.thinking-panel')).toBeNull();
+  });
+
+  it('keeps completed steps visible after the response finishes', () => {
+    renderItem(
+      assistantMessage({
+        toolTrail: [
+          { name: 'search_reliability_knowledge', done: true },
+          { name: 'analyze_weibull', done: true },
+        ],
+      }),
+      false,
+      false,
+    );
+    const trail = screen.getByRole('list', { name: 'Analysis progress' });
+    expect(within(trail).getByText('Searched knowledge base')).toBeTruthy();
+    expect(within(trail).getByText('Fit Weibull distribution')).toBeTruthy();
+  });
+
+  it('shows no trail when no tools ran', () => {
+    renderItem(assistantMessage({ toolTrail: [] }), false, false);
+    expect(screen.queryByRole('list', { name: 'Analysis progress' })).toBeNull();
+  });
+});
+
+describe('live status', () => {
+  it('shows the latest progress note while waiting', () => {
+    renderItem(assistantMessage({ content: '', statusText: 'Retrying with an explicit tool call.' }), true, true);
+    expect(screen.getByRole('status').textContent).toContain('Retrying with an explicit tool call.');
+  });
+
+  it('hides the progress note once the turn is done', () => {
+    renderItem(assistantMessage({ statusText: 'Retrying with an explicit tool call.' }), true, false);
+    expect(screen.queryByRole('status')).toBeNull();
+  });
+
+  it('shows a default note while waiting for the first content', () => {
+    renderItem(assistantMessage({ content: '', statusText: undefined }), true, true);
+    expect(screen.getByRole('status').textContent).toContain('Working');
+  });
+});
+
+describe('math subscripts', () => {
+  it('renders B_10 as a subscript using standard LaTeX notation', () => {
+    const { container } = renderItem(
+      assistantMessage({ content: 'Weibull $B_{10} = 129.9$ hours.' }),
+      false,
+      false,
+    );
+    expect(container.textContent).toContain('129.9');
+    // Standard LaTeX subscripts should render cleanly without \sb
+    expect(container.textContent).not.toContain('\\sb');
+  });
+});
+
+describe('plot gallery', () => {
+  it('renders every plot attached to the turn', () => {
+    const { container } = renderItem(
+      assistantMessage({ imageUrls: ['/static/fit.png', '/static/km.png'] }),
+      false,
+      false,
