+import { describe, expect, it } from "vitest";
+import { renderHook, act } from "@testing-library/react";
+import { usePromptHistory } from "./usePromptHistory";
+import type { Message } from "../types/chat";
+
+function msg(content: string, role: Message["role"] = "user"): Message {
+  return { id: `m-${content}`, role, content, timestamp: Date.now() };
+}
+
+describe("usePromptHistory", () => {
+  it("derives history from user messages only, trims and skips empties", () => {
+    const { result } = renderHook(() =>
+      usePromptHistory([msg("  hello "), msg("assistant hi", "assistant"), msg(""), msg("world")]),
+    );
+    expect(result.current.history).toEqual(["hello", "world"]);
+  });
+
+  it("collapses consecutive duplicates", () => {
+    const { result } = renderHook(() => usePromptHistory([msg("a"), msg("a"), msg("b"), msg("b"), msg("a")]));
+    expect(result.current.history).toEqual(["a", "b", "a"]);
+  });
+
+  it("Up goes to newest then older, Down walks forward and restores draft", () => {
+    const { result } = renderHook(() => usePromptHistory([msg("first"), msg("second"), msg("third")]));
+    // Up from draft "typing" -> third
+    act(() => {
+      const r = result.current.move("up", "typing");
+      expect(r.nextValue).toBe("third");
+      expect(r.didHandle).toBe(true);
+    });
+    act(() => {
+      const r = result.current.move("up", result.current.history[result.current.cursor!]);
+      expect(r.nextValue).toBe("second");
+    });
+    act(() => {
+      const r = result.current.move("up", result.current.history[result.current.cursor!]);
+      expect(r.nextValue).toBe("first");
+    });
+    // Up at oldest stays
+    act(() => {
+      const r = result.current.move("up", result.current.history[result.current.cursor!]);
+      expect(r.nextValue).toBe("first");
+    });
+    // Down toward newest
+    act(() => {
+      const r = result.current.move("down", result.current.history[result.current.cursor!]);
+      expect(r.nextValue).toBe("second");
+    });
+    act(() => {
+      const r = result.current.move("down", result.current.history[result.current.cursor!]);
+      expect(r.nextValue).toBe("third");
+    });
+    // Down past newest restores draft
+    act(() => {
+      const r = result.current.move("down", "third");
+      expect(r.nextValue).toBe("typing");
+      expect(r.nextCursor).toBe(null);
+    });
+  });
+
+  it("Down when not browsing does nothing", () => {
+    const { result } = renderHook(() => usePromptHistory([msg("hi")]));
+    const r = result.current.move("down", "draft");
+    expect(r.didHandle).toBe(false);
+    expect(r.nextValue).toBe("draft");
+  });
+
+  it("empty history does not handle", () => {
+    const { result } = renderHook(() => usePromptHistory([]));
+    expect(result.current.move("up", "").didHandle).toBe(false);
+  });
+
+  it("onEdited clears cursor (typing exits browsing)", () => {
+    const { result } = renderHook(() => usePromptHistory([msg("a"), msg("b")]));
+    act(() => void result.current.move("up", ""));
+    expect(result.current.cursor).not.toBe(null);
+    act(() => result.current.onEdited());
+    expect(result.current.cursor).toBe(null);
+  });
+
+  it("resets when history length changes (new message sent)", () => {
+    const { result, rerender } = renderHook(({ msgs }: { msgs: Message[] }) => usePromptHistory(msgs), {
+      initialProps: { msgs: [msg("a")] as Message[] },
+    });
+    act(() => void result.current.move("up", "draft"));
+    expect(result.current.cursor).toBe(0);
+    rerender({ msgs: [msg("a"), msg("b")] });
+    expect(result.current.cursor).toBe(null);
+  });
+});
