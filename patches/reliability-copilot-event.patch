+            content="Fit Weibull for 6 units: failures at 150, 180 hours",
+        ),
+        ChatMessage(
+            role="assistant",
+            content="β = 2.10 via MLE. Plot: `weibull_plot_abc123.png`.",
+        ),
+    ]
+    out = build_context_ledger(hist)
+    assert "- Units: hours" in out
+    assert "- Method: MLE" in out
