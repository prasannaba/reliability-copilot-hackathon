index 0000000000000000000000000000000000000000..38d030cd889a149d854507ef643cb24302e41228
--- /dev/null
+++ b/backend/tests/test_planning.py
@@ -0,0 +1,80 @@
+"""Warranty forecast + demonstration-test planning tools."""
+
+from __future__ import annotations
+
+import pytest
+
+from src.domains.reliability.planning import demonstration_test_plan, warranty_failure_forecast
+from src.domains.reliability.tools.planning import (
+    forecast_warranty_failures,
+    plan_demonstration_test,
+)
+
+
+def test_warranty_forecast_exponential_case():
+    # beta=1, eta=1000, t=100 -> F = 1-exp(-0.1) = 0.0951626; mean of 1000 = 95.16
+    out = warranty_failure_forecast(1.0, 1000.0, 100.0, 1000)
+    assert out["failure_probability_by_warranty"] == pytest.approx(0.0951626, abs=1e-6)
+    assert out["expected_failures"] == pytest.approx(95.1626, abs=1e-3)
+    lower, upper = out["failure_count_interval"]
+    assert lower < out["expected_failures"] < upper
+    assert out["units"] == "hours"
+
+
+def test_warranty_forecast_wrapper_and_units():
+    out = forecast_warranty_failures(2.0, 500.0, 250.0, 100, units="cycles")
+    assert out["population"] == 100
+    assert out["units"] == "cycles"
+    assert 0.0 < out["reliability_at_warranty"] < 1.0
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"beta": 0.0, "eta": 100.0, "warranty_time": 10.0, "population": 10},
+        {"beta": 1.0, "eta": -1.0, "warranty_time": 10.0, "population": 10},
+        {"beta": 1.0, "eta": 100.0, "warranty_time": 0.0, "population": 10},
+        {"beta": 1.0, "eta": 100.0, "warranty_time": 10.0, "population": 0},
+        {"beta": 1.0, "eta": 100.0, "warranty_time": 10.0, "population": 2.5},
+        {"beta": 1.0, "eta": 100.0, "warranty_time": 10.0, "population": 10, "confidence": 1.0},
+        {"beta": float("nan"), "eta": 100.0, "warranty_time": 10.0, "population": 10},
+    ],
+)
+def test_warranty_forecast_rejects_invalid(kwargs):
+    with pytest.raises(ValueError):
+        warranty_failure_forecast(**kwargs)
+
+
+def test_demo_plan_sample_size_at_mission_duration():
+    # R=0.9, C=0.9, beta=1, t=mission -> n = ln(0.1)/ln(0.9) = 21.85 -> 22
+    out = demonstration_test_plan(0.90, 0.90, 1.0, 1000.0, test_duration=1000.0)
+    assert out["mode"] == "required_sample_size"
+    assert out["sample_size"] == 22
+    assert out["exact_sample_size_before_rounding"] == pytest.approx(21.854, abs=1e-3)
+    assert out["achieved_confidence"] >= 0.90
+
+
+def test_demo_plan_longer_test_needs_fewer_units():
+    # Doubling test duration with beta=2 divides the required n by 4.
+    out = demonstration_test_plan(0.90, 0.90, 2.0, 1000.0, test_duration=2000.0)
+    assert out["sample_size"] == 6  # ceil(21.854 / 4)
+
+
+def test_demo_plan_solves_duration_for_sample_size():
+    # n=10, beta=1 -> ratio = (ln(0.1)/(10 ln(0.9))) = 2.1854 -> 2185.4 h for 1000 h mission
+    out = plan_demonstration_test(0.90, 0.90, 1.0, 1000.0, sample_size=10)
+    assert out["mode"] == "required_test_duration"
+    assert out["test_duration"] == pytest.approx(2185.4, abs=1.0)
+    assert out["achieved_confidence"] == pytest.approx(0.90, abs=1e-9)
+    assert out["zero_failures_allowed"] == 0
+
+
+def test_demo_plan_rejects_invalid():
+    with pytest.raises(ValueError):
+        demonstration_test_plan(0.90, 0.90, 1.0, 1000.0)  # neither unknown given
+    with pytest.raises(ValueError):
+        demonstration_test_plan(0.90, 0.90, 1.0, 1000.0, sample_size=10, test_duration=10.0)
