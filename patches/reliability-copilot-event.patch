+"""Parametric life-distribution fitting for the standard life-data-analysis family set.
+
+Generic right-censored MLE over scipy.stats families (exponential, Weibull,
+normal, lognormal, logistic, log-logistic, Gumbel/SEV-for-minima) with AIC
+ranking. One engine — no per-family formula forks.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import numpy as np
+from scipy import stats
+from scipy.optimize import minimize
+
+# Registry: scipy distribution, parameter names, AIC parameter count.
+# loc is fixed at 0 for positive-support families; Gumbel/SEV uses the
+# minima form (scipy gumbel_l), matching reliability usage.
+_FAMILIES: dict[str, dict[str, Any]] = {
+    "exponential": {
+        "dist": stats.expon,
+        "param_names": ("lambda",),
+        "k": 1,
+        "fixed": {"floc": 0},
+        "to_args": lambda theta: (0.0, theta[0]),
+        "from_fit": lambda fit: (fit[1],),
+        "labels": ("scale",),
+    },
+    "weibull": {
+        "dist": stats.weibull_min,
+        "param_names": ("beta", "eta"),
+        "k": 2,
+        "fixed": {"floc": 0},
+        "to_args": lambda theta: (theta[0], 0.0, theta[1]),
+        "from_fit": lambda fit: (fit[0], fit[2]),
+        "labels": ("shape", "scale"),
+    },
+    "normal": {
+        "dist": stats.norm,
+        "param_names": ("mu", "sigma"),
+        "k": 2,
+        "fixed": {},
+        "to_args": lambda theta: (theta[0], theta[1]),
+        "from_fit": lambda fit: (fit[0], fit[1]),
+        "labels": ("loc", "scale"),
+    },
+    "lognormal": {
+        "dist": stats.lognorm,
+        "param_names": ("sigma", "median"),
+        "k": 2,
+        "fixed": {"floc": 0},
+        "to_args": lambda theta: (theta[0], 0.0, theta[1]),
+        "from_fit": lambda fit: (fit[0], fit[2]),
+        "labels": ("shape", "scale"),
+    },
+    "logistic": {
+        "dist": stats.logistic,
+        "param_names": ("mu", "s"),
+        "k": 2,
+        "fixed": {},
+        "to_args": lambda theta: (theta[0], theta[1]),
+        "from_fit": lambda fit: (fit[0], fit[1]),
+        "labels": ("loc", "scale"),
+    },
+    "loglogistic": {
+        "dist": stats.fisk,
+        "param_names": ("beta", "alpha"),
+        "k": 2,
+        "fixed": {"floc": 0},
+        "to_args": lambda theta: (theta[0], 0.0, theta[1]),
+        "from_fit": lambda fit: (fit[0], fit[2]),
+        "labels": ("shape", "scale"),
+    },
+    "gumbel-sev": {
+        "dist": stats.gumbel_l,
+        "param_names": ("mu", "beta"),
+        "k": 2,
+        "fixed": {},
+        "to_args": lambda theta: (theta[0], theta[1]),
+        "from_fit": lambda fit: (fit[0], fit[1]),
+        "labels": ("loc", "scale"),
+    },
+}
+
+_ALIASES = {"gumbel": "gumbel-sev", "sev": "gumbel-sev"}
+
+CANDIDATE_FAMILIES = tuple(_FAMILIES)
+
+
+def normalize_family(name: Any) -> str:
+    """Lowercase/strip a family name, resolving aliases; fail closed."""
+    if not isinstance(name, str):
+        raise ValueError(f"family must be one of {list(CANDIDATE_FAMILIES)}")
+    key = name.strip().lower().replace("_", "-")
+    key = _ALIASES.get(key, key)
+    if key not in _FAMILIES:
+        raise ValueError(f"family must be one of {list(CANDIDATE_FAMILIES)}")
+    return key
+
+
+def _validate_times(
+    failure_times: Any, censored_times: Any
+) -> tuple[np.ndarray, np.ndarray]:
+    failures = np.asarray(failure_times, dtype=float)
+    censored = np.asarray(censored_times if censored_times is not None else [], dtype=float)
+    if failures.size < 2:
+        raise ValueError("at least two failure times are required")
+    if not np.all(np.isfinite(failures)) or np.any(failures <= 0):
+        raise ValueError("failure times must be finite and greater than zero")
+    if censored.size and (not np.all(np.isfinite(censored)) or np.any(censored < 0)):
+        raise ValueError("censored times must be finite and zero or greater")
+    return failures, censored
+
+
+def _bounds_for(family: str) -> list[tuple[float | None, float | None]]:
+    entry = _FAMILIES[family]
+    bounds: list[tuple[float | None, float | None]] = []
+    for label in entry["labels"]:
+        if label == "scale" or label == "shape":
+            bounds.append((1e-9, None))
+        else:
+            bounds.append((None, None))
+    return bounds
+
+
+def fit_family(
+    family: str,
+    failure_times: list[float] | tuple[float, ...] | np.ndarray,
+    censored_times: list[float] | tuple[float, ...] | np.ndarray | None = None,
+) -> dict[str, Any]:
+    """Right-censored MLE for one family; falls back to complete-data fit."""
+    key = normalize_family(family)
+    entry = _FAMILIES[key]
+    dist = entry["dist"]
+    failures, censored = _validate_times(failure_times, censored_times)
+
+    try:
+        start = np.asarray(entry["from_fit"](dist.fit(failures, **entry["fixed"])), dtype=float)
+    except Exception as exc:
+        raise RuntimeError(f"{key} initial fit failed: {exc}") from exc
+
+    def nll(theta: np.ndarray) -> float:
+        if np.any(~np.isfinite(theta)):
+            return 1e12
+        args = entry["to_args"](theta)
+        try:
+            ll_fail = np.sum(dist.logpdf(failures, *args))
+            ll_cens = np.sum(dist.logsf(censored, *args)) if censored.size else 0.0
+        except Exception:
+            return 1e12
+        total = ll_fail + ll_cens
+        if not np.isfinite(total):
+            return 1e12
+        return float(-total)
+
+    refined = minimize(nll, start, method="L-BFGS-B", bounds=_bounds_for(key))
+    fallback = False
+    if refined.success and np.isfinite(refined.fun):
+        theta = np.asarray(refined.x, dtype=float)
+    else:
+        theta, fallback = start, True
+    loglik = float(-nll(theta))
+    if not np.isfinite(loglik):
+        raise RuntimeError(f"{key} fit produced a non-finite likelihood")
+    k = int(entry["k"])
+    aic = float(2 * k - 2 * loglik)
+    params = {name: float(value) for name, value in zip(entry["param_names"], theta)}
+    return {
+        "family": key,
+        "params": params,
+        "loglik": loglik,
+        "aic": aic,
+        "k": k,
+        "n_failures": int(failures.size),
+        "n_censored": int(censored.size),
+        "converged": bool(refined.success and not fallback),
+        "fallback_to_complete_data": fallback,
+    }
+
+
+def rank_families(
+    failure_times: list[float] | tuple[float, ...] | np.ndarray,
+    censored_times: list[float] | tuple[float, ...] | np.ndarray | None = None,
+    candidates: list[str] | tuple[str, ...] | None = None,
+) -> list[dict[str, Any]]:
+    """Fit every candidate family; rank by AIC (lowest first)."""
+    if candidates is None:
+        wanted = list(CANDIDATE_FAMILIES)
+    else:
+        if not candidates:
+            raise ValueError("candidates must be non-empty when provided")
+        wanted = [normalize_family(name) for name in candidates]
+    ranked = sorted(
+        (fit_family(key, failure_times, censored_times) for key in wanted),
+        key=lambda fit: fit["aic"],
+    )
+    best = ranked[0]["aic"]
+    for fit in ranked:
+        fit["delta_aic"] = float(fit["aic"] - best)
+    return ranked
+
+
+def family_cdf(family: str, times: np.ndarray, params: dict[str, float]) -> np.ndarray:
+    """Fitted CDF values for overlay plots (same engine, no re-fitting)."""
+    key = normalize_family(family)
+    entry = _FAMILIES[key]
+    theta = np.asarray([params[name] for name in entry["param_names"]], dtype=float)
+    return np.asarray(entry["dist"].cdf(np.asarray(times, dtype=float), *entry["to_args"](theta)))
