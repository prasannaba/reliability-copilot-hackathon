+/**
+ * Composer — single-line input with history (↑/↓ at edge), paste/attach,
+ * model picker and reasoning dropdown. Auto-grows to 200px.
+ */
+import { memo, useEffect, useRef } from 'react';
+import Dropdown from 'react-bootstrap/Dropdown';
 import Form from 'react-bootstrap/Form';
 import { Icon } from './Icon';
 import { ModelPicker } from './ModelPicker';
 
+export type ReasoningEffort = 'low' | 'medium' | 'high';
+
 interface ComposerProps {
   value: string;
   onChange: (v: string) => void;
+  /** Return true if handled (prevent caret move). */
+  onHistoryPrev: () => boolean;
+  onHistoryNext: () => boolean;
   onSend: () => void;
   onStop: () => void;
   onFile: (file: File) => void;
@@ -19,31 +29,59 @@ interface ComposerProps {
