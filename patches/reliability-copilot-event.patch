+"""Exploratory data analysis: NIST 4-plot statistics (run sequence, lag,
+histogram, normal probability plot). Deterministic, scipy/numpy only.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import numpy as np
+from scipy import stats
+
+#: Rule-of-thumb floor for a readable histogram/probability plot.
+MIN_PLOT_SAMPLE = 30
+
+
+def _validate(data: list[float] | tuple[float, ...] | np.ndarray) -> np.ndarray:
+    values = np.asarray(data, dtype=float)
+    if values.ndim != 1 or values.size < 4:
+        raise ValueError("data must be a one-dimensional sample of at least 4 values")
+    if not np.all(np.isfinite(values)):
+        raise ValueError("data must contain only finite numbers")
+    return values
+
+
+def lag1_autocorrelation(values: np.ndarray) -> float | None:
+    """Lag-1 autocorrelation; None when the series has no variation."""
+    if values.size < 2 or float(np.std(values)) == 0.0:
+        return None
+    return float(np.corrcoef(values[:-1], values[1:])[0, 1])
+
+
+def analyze_eda(
+    data: list[float] | tuple[float, ...] | np.ndarray,
+) -> dict[str, Any]:
+    """Summary statistics plus 4-plot diagnostics for one data sample."""
+    values = _validate(data)
+    osm, osr = (
+        np.asarray(part) for part in stats.probplot(values, dist="norm", fit=False)
+    )
+    norm_r = float(np.corrcoef(osm, osr)[0, 1]) if osm.size > 1 else None
+    return {
+        "n": int(values.size),
+        "mean": float(np.mean(values)),
+        "std": float(np.std(values, ddof=1)) if values.size > 1 else 0.0,
+        "min": float(np.min(values)),
+        "max": float(np.max(values)),
+        "median": float(np.median(values)),
+        "skew": float(stats.skew(values)),
+        "kurtosis": float(stats.kurtosis(values)),
+        "lag1_autocorrelation": lag1_autocorrelation(values),
+        "normal_probplot_r": norm_r,
+        "small_sample_warning": (
+            f"only {values.size} values (rule-of-thumb floor is {MIN_PLOT_SAMPLE}) — "
+            "histogram and probability plot shapes are unstable"
+            if values.size < MIN_PLOT_SAMPLE
+            else None
+        ),
+    }
diff --git a/backend/src/domains/reliability/growth_fit.py b/backend/src/domains/reliability/growth_fit.py
