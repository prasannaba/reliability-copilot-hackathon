+def plot_kaplan_meier(km: dict, title: str = "Kaplan-Meier Survival Estimate") -> dict:
+    """Step plot of the KM survival curve with Greenwood bounds and median."""
+    from src.domains.reliability.tools._common import PLOT_LOCK
+
+    times = np.asarray(km["times"], dtype=float)
+    surv = np.asarray(km["survival"], dtype=float)
+    with PLOT_LOCK:
+        fig, ax = plt.subplots(figsize=(8, 5))
+        ax.step(times, surv, where="post", linewidth=2, label="KM survival")
+        ax.fill_between(
+            times,
+            np.asarray(km["ci_lower"], dtype=float),
+            np.asarray(km["ci_upper"], dtype=float),
+            step="post",
+            alpha=0.25,
+            label="95% Greenwood bounds",
+        )
+        ax.scatter(times, surv, s=18, zorder=3)
+        if km.get("median") is not None:
+            ax.axvline(
+                km["median"],
+                linestyle="--",
+                linewidth=1.2,
+                label=f"median {km['median']:g}",
+            )
+        ax.set_title(title)
+        ax.set_xlabel("Time")
+        ax.set_ylabel("Survival probability")
+        ax.set_ylim(-0.05, 1.05)
+        ax.legend()
+        ax.grid(True, alpha=0.3)
+        STATIC_DIR.mkdir(parents=True, exist_ok=True)
+        save_path = str(
+            plot_path_for(
+                "km_plot",
+                np.asarray(km["times"], dtype=float).tolist(),
+                np.asarray(km["survival"], dtype=float).tolist(),
+                np.asarray(km["ci_lower"], dtype=float).tolist(),
+                np.asarray(km["ci_upper"], dtype=float).tolist(),
+                km.get("median"),
+                title,
+            )
+        )
+        fig.savefig(save_path, dpi=150, bbox_inches="tight")
+        plt.close(fig)
+    return {"file": save_path}
