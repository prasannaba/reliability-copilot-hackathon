+async def warmup_knowledge_index(app: FastAPI) -> None:
+    """One-time background warmup: load the embedder and reconcile the index.
+
+    Runs at startup so the first chat prompt never pays the model-load cost.
+    Never raises: failures are recorded on app.state for /api/knowledge/status.
+    """
+    try:
+        app.state.index_warnings = await asyncio.to_thread(_warm_knowledge)
+    except Exception as exc:  # noqa: BLE001 - warmup must never crash boot
+        logging.getLogger(__name__).warning("Knowledge index warmup failed: %s", exc)
+        app.state.index_ready = False
+        app.state.index_error = str(exc) or type(exc).__name__
+        return
+    app.state.index_ready = True
+    app.state.index_error = None
+
