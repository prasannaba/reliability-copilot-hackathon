diff --git a/scripts/dev.ps1 b/scripts/dev.ps1
index 892df1a8d9a17e7731701280ce8e05750af456c0..5d4fd4b9fa24c0bee40f37f09e2245c350ea99e2 100644
--- a/scripts/dev.ps1
+++ b/scripts/dev.ps1
@@ -1,8 +1,5 @@
 # One-command development: FastAPI backend (:8000) + Vite dev server (:4200).
-# Ctrl+C stops both. Run from anywhere: .\scripts\dev.ps1 [-Domain physics]
-param(
-  [string]$Domain = ""
-)
+# Ctrl+C stops both. Run from anywhere: .\scripts\dev.ps1
 $ErrorActionPreference = "Stop"
 $root = Split-Path -Parent $PSScriptRoot
 
@@ -30,21 +27,34 @@ if (-not (Test-Path (Join-Path $root "frontend\node_modules"))) {
 }
 
 Write-Host "Starting backend (background) + Vite dev server (foreground)..."
-$backend = Start-Job -Name "reliability-backend" -WorkingDirectory (Join-Path $root "backend") -ArgumentList $Domain -ScriptBlock {
-  param([string]$JobDomain)
-  if ($JobDomain) {
-    $env:ACTIVE_DOMAIN = $JobDomain
-  }
-  uv sync --all-groups
-  uv run python -m src.host.app
+# Sync dependencies only when the venv is missing or the lockfile is newer;
+# uv run syncs by itself otherwise, so restarts stay fast.
+$uvSync = @("--no-sync")
+$venvPath = Join-Path $root "backend\.venv"
+$lockPath = Join-Path $root "backend\uv.lock"
+if ((-not (Test-Path $venvPath)) -or ((Get-Item $lockPath).LastWriteTime -gt (Get-Item $venvPath).LastWriteTime)) {
+  $uvSync = @()
 }
+# Start-Process (not Start-Job): the live PID plus taskkill /T kills the
+# whole tree (uv + its python grandchild), so Ctrl+C cannot orphan port 8000.
+$backend = Start-Process uv -ArgumentList (@("run") + $uvSync + @("python", "-m", "src.host.app")) -WorkingDirectory (Join-Path $root "backend") -PassThru
 try {
+  Write-Host "Waiting for backend http://127.0.0.1:8000/health ..."
+  $ready = $false
+  for ($i = 0; $i -lt 120; $i++) {
+    try {
+      $r = Invoke-WebRequest -UseBasicParsing http://127.0.0.1:8000/health -TimeoutSec 2
+      if ($r.StatusCode -eq 200) { $ready = $true; break }
+    } catch {}
+    Start-Sleep -Seconds 2
+  }
+  if (-not $ready) { throw "Backend did not become ready in 240s." }
+  Write-Host "Backend is up."
   Push-Location (Join-Path $root "frontend")
   npm run dev
 }
 finally {
   Pop-Location
-  Write-Host "Stopping backend..."
-  Stop-Job $backend | Out-Null
-  Remove-Job $backend | Out-Null
+  Write-Host "Stopping backend (whole process tree)..."
+  & taskkill /PID $backend.Id /T /F 2>&1 | Out-Null
 }
diff --git a/scripts/dev.sh b/scripts/dev.sh
index 3ad6fdbb5af64bb37cad9c125633237471f73f08..9dfa172a7ee2d5d6a7c6cc9256302fe506b4727e 100644
--- a/scripts/dev.sh
+++ b/scripts/dev.sh
@@ -1,15 +1,9 @@
 #!/usr/bin/env bash
 # One-command development: FastAPI backend (:8000) + Vite dev server (:4200).
 # Ctrl+C stops both.
-# Usage: ./scripts/dev.sh [--domain physics]
+# Usage: ./scripts/dev.sh
 set -euo pipefail
 ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
-for arg in "$@"; do
-  case "$arg" in
-    --domain=*) export ACTIVE_DOMAIN="${arg#--domain=}" ;;
-    *) echo "Unknown argument: $arg (expected --domain=NAME)" >&2; exit 1 ;;
-  esac
-done
 
 command -v uv >/dev/null || { echo "uv not found. Install it: https://docs.astral.sh/uv/" >&2; exit 1; }
 command -v npm >/dev/null || { echo "npm not found. Install Node LTS first." >&2; exit 1; }
@@ -17,10 +11,16 @@ if [ ! -f "$ROOT/.env" ]; then
   echo "WARNING: .env not found at repo root. Copy .env.example to .env and set LLM_API_BASE." >&2
 fi
 
+port_busy() { # $1 = port. Works in Git Bash: ss/lsof first, stdlib /dev/tcp fallback.
+  if command -v ss >/dev/null && ss -ltn 2>/dev/null | grep -q ":$1 "; then return 0; fi
+  if command -v lsof >/dev/null && lsof -i ":$1" -sTCP:LISTEN -t >/dev/null 2>&1; then return 0; fi
+  (echo > "/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1
+}
+
 for port in 8000 4200; do
-  if (command -v ss >/dev/null && ss -ltn | grep -q ":$port ") || \
-     (command -v lsof >/dev/null && lsof -i ":$port" -sTCP:LISTEN -t >/dev/null 2>&1); then
-    echo "Port $port is already in use. Stop that process first." >&2
+  if port_busy "$port"; then
+    echo "Port $port is already in use (a previous server may still be running)." >&2
+    echo "Find it with: netstat -ano | findstr :$port  — then: taskkill /F /PID <pid>" >&2
     exit 1
   fi
 done
@@ -31,8 +31,43 @@ if [ ! -d "$ROOT/frontend/node_modules" ]; then
 fi
 
 echo "Starting backend (background) + Vite dev server (foreground)..."
-(cd "$ROOT/backend" && uv sync --all-groups && uv run python -m src.host.app) &
+# Sync dependencies only when the venv is missing or the lockfile is newer;
+# uv run syncs by itself otherwise, so restarts stay fast.
+UV_SYNC="--no-sync"
+if [ ! -d "$ROOT/backend/.venv" ] || [ "$ROOT/backend/uv.lock" -nt "$ROOT/backend/.venv" ]; then
+  UV_SYNC=""
+fi
+# exec makes the trapped PID the server itself (not a wrapper subshell),
+# so Ctrl+C cannot orphan it holding port 8000.
+(cd "$ROOT/backend" && exec uv run $UV_SYNC python -m src.host.app) &
 BACKEND_PID=$!
-trap 'kill $BACKEND_PID 2>/dev/null || true' EXIT INT TERM
+cleanup() {
+  kill "$BACKEND_PID" 2>/dev/null || true
+  wait "$BACKEND_PID" 2>/dev/null || true
+  if port_busy 8000; then
+    echo "NOTE: port 8000 is still busy after shutdown; free it with:" >&2
+    echo "  netstat -ano | findstr :8000  — then: taskkill /F /PID <pid>" >&2
+  fi
+}
+trap cleanup EXIT INT TERM
+
+# Wait for the backend (embedding warmup can take minutes) before starting
+# Vite, so the first page load never hits a proxy ECONNREFUSED storm.
+if command -v curl >/dev/null; then
+  echo "Waiting for backend http://127.0.0.1:8000/health ..."
+  for i in $(seq 1 120); do
+    if curl -fsS http://127.0.0.1:8000/health >/dev/null 2>&1; then
+      echo "Backend is up."
+      break
+    fi
+    if [ "$i" = 120 ]; then
+      echo "Backend did not become ready in 240s; check the backend output above." >&2
+      exit 1
+    fi
+    sleep 2
+  done
+else
+  echo "WARNING: curl not found; skipping backend readiness wait." >&2
+fi
 
 (cd "$ROOT/frontend" && npm run dev)
