+
+### Message Structure
+
+**File**: `frontend/src/types/chat.ts`
+
+```typescript
+export interface Message {
+  id: string;
+  role: 'user' | 'assistant';
+  content: string;
+  timestamp: number;
+  model?: string;
+  stats?: string;              // "12.3s · ~328 tokens"
+  imageUrl?: string;          // Plot image URL
+  thinkingText?: string;      // Thinking content
