+import { afterEach, describe, expect, it } from 'vitest';
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { SettingsPanel } from './SettingsPanel';
+import type { BackendService } from '../services/types';
+import type { LlmConfigUpdate, LlmTestResult } from '../types/llm';
+
+afterEach(cleanup);
+
+function backend(calls: LlmConfigUpdate[]): BackendService {
+  return {
+    kind: 'browser',
+    baseUrl: '',
+    listModels: async () => ({
+      configured: true,
+      models: ['m'],
+      current: 'm',
+      base: '',
+      provider: 'ollama',
+    }),
+    getLlmConfig: async () => ({
+      provider: 'ollama',
+      baseUrl: 'http://localhost:11434',
+      hasApiKey: false,
+      model: '',
+      temperature: 0.1,
+      systemPrompt: '',
+      configured: true,
+    }),
+    saveLlmConfig: async (update) => ({
+      provider: 'ollama',
+      baseUrl: 'http://localhost:11434',
+      hasApiKey: false,
+      model: '',
+      temperature: 0.1,
+      systemPrompt: '',
+      configured: true,
+      ...update,
+    }),
+    testLlmConfig: async (update) => {
+      calls.push(update);
+      return { ok: true, message: 'ok', models: ['m'] };
+    },
+    knowledgeStatus: async () => ({
+      embedding_model: 'stub',
+      files: [],
+      chunk_count: 0,
+      ready: true,
+      index_error: null,
+      index_warnings: [],
+    }),
+    uploadDocument: async () => ({ source: 'f', indexed: true, message: 'ok' }),
+        listMcpTools: async () => ({ tools: [], count: 0 }),
+    streamMessage: async () => undefined,
+    downloadFile: async () => new Blob(),
+    resolveStaticUrl: (url: string) => url,
+  };
+}
+
+function renderPanel(calls: LlmConfigUpdate[]) {
+  render(
+    <SettingsPanel
+      backend={backend(calls)}
+      show
+      config={{
+        provider: 'ollama',
+        baseUrl: 'http://localhost:11434',
+        hasApiKey: false,
+        model: '',
+        temperature: 0.1,
+        systemPrompt: '',
+        configured: true,
+      }}
+      selectedModelFallback=""
+      exportFormat="markdown"
+      onExportFormatChange={() => undefined}
+      themeChoice="system"
+      onThemeChoice={() => undefined}
+      onClearAll={() => undefined}
+      clearDisabled
+      onClose={() => undefined}
+    />,
+  );
+}
+
+describe('SettingsPanel model reload', () => {
+  it('keeps the model select clickable while reloading', async () => {
+    const gates: Array<(v: LlmTestResult) => void> = [];
+    const stub: BackendService = {
+      ...backend([]),
+      testLlmConfig: () =>
+        new Promise<LlmTestResult>((resolve) => {
+          gates.push(resolve);
+        }),
+    };
+    render(
+      <SettingsPanel
+        backend={stub}
+        show
+        config={{
+          provider: 'ollama',
+          baseUrl: 'http://localhost:11434',
+          hasApiKey: false,
+          model: '',
+          temperature: 0.1,
+          systemPrompt: '',
+          configured: true,
+        }}
+        selectedModelFallback=""
+        exportFormat="markdown"
+        onExportFormatChange={() => undefined}
+        themeChoice="system"
+        onThemeChoice={() => undefined}
+        onClearAll={() => undefined}
+        clearDisabled
+        onClose={() => undefined}
+      />,
+    );
+    await waitFor(() => expect(gates.length).toBe(1));
+    gates[0]({ ok: true, message: 'ok', models: ['m1'] });
+    await waitFor(() => expect(screen.getByRole('option', { name: 'm1' })).toBeTruthy());
+    fireEvent.click(screen.getByRole('button', { name: 'Refresh' }));
+    await waitFor(() => expect(gates.length).toBe(2));
+    await waitFor(() =>
+      expect((screen.getByLabelText('Model') as HTMLSelectElement).disabled).toBe(false),
+    );
+    gates[1]({ ok: true, message: 'ok', models: ['m1'] });
+    await waitFor(() => expect(screen.getByRole('option', { name: 'm1' })).toBeTruthy());
+  });
+});
+
+describe('SettingsPanel model listing', () => {
+  it('does not offer browser password autofill on the API key field', () => {
+    renderPanel([]);
+    const key = document.getElementById('llm-key');
+    expect(key?.getAttribute('autocomplete')).toBe('new-password');
+  });
+
+  it('lists models immediately with the typed key when Enter is pressed', async () => {
+    const calls: LlmConfigUpdate[] = [];
+    renderPanel(calls);
+    // Provider defaults load on open without a key.
+    await waitFor(() => expect(calls.length).toBeGreaterThan(0));
+    const key = screen.getByLabelText('API Key');
+    fireEvent.change(key, { target: { value: 'sk-enter' } });
+    fireEvent.keyDown(key, { key: 'Enter', code: 'Enter', charCode: 13 });
+    await waitFor(() =>
+      expect(calls.some((c) => c.apiKey === 'sk-enter')).toBe(true),
+    );
+  });
+});
