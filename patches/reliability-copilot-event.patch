index 0000000000000000000000000000000000000000..9121d32539de392a256f5df76ee24d39286c999d
--- /dev/null
+++ b/backend/src/domains/reliability/growth_fit.py
@@ -0,0 +1,173 @@
+"""Reliability-growth models: Duane + Crow-AMSAA (Power-Law NHPP).
+
+Single repairable system, failure-terminated or time-terminated.
+LLM never estimates — all numbers come from these deterministic fits.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import numpy as np
+from scipy.optimize import minimize
+from scipy.stats import cramervonmises
+
+
+def _validate_failure_times(
+    failure_times: np.ndarray,
+) -> np.ndarray:
+    arr = np.asarray(failure_times, dtype=float).ravel()
+    if len(arr) < 3:
+        raise ValueError("at least 3 failure times are required for growth analysis")
+    if not np.all(np.isfinite(arr)):
+        raise ValueError("failure times must be finite")
+    if np.any(arr <= 0):
+        raise ValueError("failure times must be positive")
+    if np.any(np.diff(np.sort(arr)) == 0):
+        # Duplicates are allowed but warn via return; handled in Duane fit.
+        pass
+    return np.sort(arr)
+
+
+def duane_fit(failure_times: np.ndarray) -> dict[str, Any]:
+    """Duane model: log cumulative MTBF vs log cumulative time is linear.
+
+    Cumulative MTBF at i-th failure:  T_i / i  (T_i = cumulative time to i-th failure).
+    Fit  ln(MTBF_cum) = ln(K) + alpha * ln(T)  via OLS.
+    Returns slope alpha (growth rate), intercept, R^2, and fitted line.
+    """
+    t = _validate_failure_times(failure_times)
+    cum_mtbf = t / np.arange(1, len(t) + 1, dtype=float)
+    x = np.log(t)
+    y = np.log(cum_mtbf)
+    # OLS: y = a + alpha*x
+    slope, intercept = np.polyfit(x, y, 1)
+    y_hat = slope * x + intercept
+    ss_res = float(np.sum((y - y_hat) ** 2))
+    ss_tot = float(np.sum((y - y.mean()) ** 2))
+    r2 = 1.0 - ss_res / ss_tot if ss_tot > 0 else 0.0
+    return {
+        "alpha": float(slope),
+        "log_K": float(intercept),
+        "K": float(np.exp(intercept)),
+        "r_squared": float(r2),
+        "x": x,
+        "y": y,
+        "y_hat": y_hat,
+        "cum_mtbf": cum_mtbf,
+        "t": t,
+    }
+
+
+def crow_amsaa_fit(
+    failure_times: np.ndarray,
+    time_terminated: float | None = None,
+) -> dict[str, Any]:
+    """Crow-AMSAA / Power-Law NHPP MLE.
+
+    Intensity:  rho(t) = lambda * beta * t^{beta-1}
+    Mean value:  Lambda(t) = lambda * t^beta
+    beta < 1 => reliability growth (failure intensity decreasing).
+    beta = 1 => HPP (no growth).
+
+    MLE (see Crow 1974, Rigdon & Basu): for failure-terminated at t_n,
+    or time-terminated at T > t_n.  Uses Nelder-Mead on negative log-likelihood.
+    Returns beta, lambda, intensity at last observation, instantaneous MTBF,
+    and Cramer-von Mises goodness-of-fit.
+    """
+    t = _validate_failure_times(failure_times)
+    n = len(t)
+    # Termination time: last failure if failure-terminated, else given T
+    if time_terminated is not None:
+        if not np.isfinite(time_terminated) or time_terminated <= 0:
+            raise ValueError("time_terminated must be positive and finite")
+        if time_terminated < t[-1]:
+            raise ValueError("time_terminated must be >= last failure time")
+        T = float(time_terminated)
+        terminated = "time"
+    else:
+        T = float(t[-1])
+        terminated = "failure"
+
+    # MLE via optimization of beta; lambda has closed form given beta.
+    # Log-likelihood (failure-terminated):
+    #   ln L = n ln lambda + n ln beta + (beta-1) sum ln t_i - lambda T^beta
+    # Maximizing w.r.t lambda gives lambda_hat = n / T^beta.
+    # Profile log-likelihood in beta alone:
+    #   l(beta) = n ln n - n ln T^beta + n ln beta + (beta-1) sum ln t_i - n
+    # For time-terminated, same with n = observed failures, T = truncation.
+    sum_log_t = float(np.sum(np.log(t)))
+
+    def neg_profile_ll(beta_arr: np.ndarray) -> float:
+        b = float(beta_arr[0])
+        if b <= 1e-6:
+            return 1e12
+        # profile negative log-likelihood
+        return float(n * np.log(T**b / n) - n * np.log(b) - (b - 1) * sum_log_t + n)
+
+    # Start beta from Duane slope + 1 (Duane alpha = beta - 1 for PLP)
+    try:
+        duane = duane_fit(t)
+        beta0 = float(np.clip(duane["alpha"] + 1.0, 0.1, 5.0))
+    except Exception:
+        beta0 = 1.0
+
+    res = minimize(neg_profile_ll, x0=np.array([beta0]), method="Nelder-Mead")
+    beta_hat = float(res.x[0]) if res.success and res.x[0] > 1e-6 else beta0
+    beta_hat = float(np.clip(beta_hat, 1e-3, 20.0))
+    lambda_hat = float(n / (T**beta_hat)) if T > 0 else 0.0
+
+    # Intensity and instantaneous MTBF at last observation
+    rho_T = float(lambda_hat * beta_hat * T ** (beta_hat - 1)) if T > 0 else 0.0
+    mtbf_inst = float(1.0 / rho_T) if rho_T > 0 else float("inf")
+
+    # Cramer-von Mises GOF (failure-terminated formula, Rigdon-Basu)
+    # Transform to uniform: u_i = (t_i / T)^beta
+    u = (t / T) ** beta_hat if T > 0 else np.array([])
+    # CvM statistic for uniform goodness-of-fit (small => good fit)
+    cvm_stat: float | None = None
+    cvm_p: float | None = None
+    try:
+        if len(u) >= 3:
+            cvm_res = cramervonmises(u, "uniform")
+            cvm_stat = float(cvm_res.statistic)
+            cvm_p = float(cvm_res.pvalue)
+    except Exception:
+        pass
+
+    return {
+        "beta": beta_hat,
+        "lambda": lambda_hat,
+        "T": T,
+        "n": n,
+        "termination": terminated,
+        "intensity_at_T": rho_T,
+        "mtbf_instantaneous": mtbf_inst,
+        "duane_alpha": float(beta_hat - 1.0),
+        "cvm_statistic": cvm_stat,
+        "cvm_pvalue": cvm_p,
+    }
+
+
+def forecast_crow_amsaa(
+    fit: dict[str, Any],
+    forecast_time: float,
+) -> dict[str, float]:
+    """Forecast instantaneous MTBF at a future cumulative time.
+
+    Uses Crow-AMSAA intensity: rho(t) = lambda beta t^{beta-1}
+    MTBF_inst(t) = 1 / rho(t).
+    """
+    if not np.isfinite(forecast_time) or forecast_time <= 0:
+        raise ValueError("forecast_time must be positive and finite")
+    beta = float(fit["beta"])
+    lam = float(fit["lambda"])
+    rho = float(lam * beta * forecast_time ** (beta - 1))
+    mtbf = float(1.0 / rho) if rho > 0 else float("inf")
+    expected_failures = float(lam * forecast_time**beta)
+    return {
+        "forecast_time": float(forecast_time),
+        "forecast_intensity": rho,
+        "forecast_mtbf": mtbf,
+        "forecast_cumulative_failures": expected_failures,
+    }
