+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+sys.path.append(str(Path(__file__).resolve().parents[1]))
+
+from src.domains.reliability.tools import eda as eda_tools
+from src.domains.reliability.tools._common import STATIC_DIR
+
+
+def test_eda_stats_match_numpy_scipy():
+    from scipy import stats as sstats
+
+    data = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
+    result = eda_tools.analyze_exploratory_data(data)
+    assert result["n"] == 8
+    assert result["mean"] == pytest.approx(5.0)
+    assert result["std"] == pytest.approx(float(np.std(data, ddof=1)))
+    assert result["median"] == pytest.approx(4.5)
+    assert result["skew"] == pytest.approx(float(sstats.skew(data)))
+    assert result["lag1_autocorrelation"] == pytest.approx(
+        float(np.corrcoef(data[:-1], data[1:])[0, 1])
+    )
+    assert result["small_sample_warning"] is not None  # n < 30
+    assert result["file"].endswith(".png")
+    assert (STATIC_DIR / result["file"]).is_file()
+
+
+def test_eda_detects_strong_lag1_structure():
+    ramp = [float(value) for value in range(50)]
+    result = eda_tools.analyze_exploratory_data(ramp)
+    assert result["lag1_autocorrelation"] == pytest.approx(1.0, abs=0.01)
+    assert result["small_sample_warning"] is None
+
+
+def test_eda_normal_data_scores_high_probplot_r():
+    rng = np.random.default_rng(11)
+    result = eda_tools.analyze_exploratory_data(rng.normal(size=200).tolist())
+    assert result["normal_probplot_r"] is not None
+    assert result["normal_probplot_r"] > 0.99
+
+
+def test_eda_rejects_bad_inputs():
+    with pytest.raises(ValueError):
+        eda_tools.analyze_exploratory_data([])
+    with pytest.raises(ValueError):
+        eda_tools.analyze_exploratory_data([1.0, 2.0, 3.0])
+    with pytest.raises(ValueError):
+        eda_tools.analyze_exploratory_data([1.0, 2.0, float("nan"), 4.0])
