+def plot_distribution_comparison(
+    km: dict,
+    fits: list[dict],
+    title: str = "Distribution Comparison vs Kaplan-Meier",
+) -> dict:
+    """KM empirical CDF step with fitted parametric CDF overlays."""
+    from src.domains.reliability.distributions import family_cdf
+    from src.domains.reliability.tools._common import PLOT_LOCK
+
+    times = np.asarray(km["times"], dtype=float)
+    empirical = 1.0 - np.asarray(km["survival"], dtype=float)
+    grid = np.linspace(times.min(), times.max(), 200)
+    with PLOT_LOCK:
+        fig, ax = plt.subplots(figsize=(8, 5))
+        ax.step(
+            times,
+            empirical,
+            where="post",
+            linewidth=2,
+            color="black",
+            label="Kaplan-Meier",
+        )
+        for fit in fits:
+            ax.plot(
+                grid,
+                family_cdf(fit["family"], grid, fit["params"]),
+                linewidth=1.5,
+                label=f"{fit['family']} (AIC {fit['aic']:.1f})",
+            )
+        ax.set_title(title)
+        ax.set_xlabel("Time")
+        ax.set_ylabel("Cumulative failure probability")
+        ax.set_ylim(-0.05, 1.05)
+        ax.legend(fontsize="small")
+        ax.grid(True, alpha=0.3)
+        STATIC_DIR.mkdir(parents=True, exist_ok=True)
+        save_path = str(
+            plot_path_for(
+                "dist_compare",
+                np.asarray(km["times"], dtype=float).tolist(),
+                [
+                    (
+                        fit.get("family"),
+                        repr(fit.get("params")),
+                        round(float(fit.get("aic", 0.0)), 6),
+                    )
+                    for fit in fits
+                ],
+                title,
+            )
+        )
+        fig.savefig(save_path, dpi=150, bbox_inches="tight")
+        plt.close(fig)
+    return {"file": save_path}
+
+
+def plot_eda_4plot(
+    data: list[float],
+    title: str = "Exploratory Data Analysis — 4-Plot",
+) -> dict:
+    """NIST 4-plot: run sequence, lag, histogram, normal probability plot."""
+    from scipy import stats as _stats
+
+    from src.domains.reliability.tools._common import PLOT_LOCK
+
+    values = np.asarray(data, dtype=float)
+    with PLOT_LOCK:
+        fig, axes = plt.subplots(2, 2, figsize=(10, 8))
+        (ax_run, ax_lag), (ax_hist, ax_prob) = axes
+        ax_run.plot(values, marker="o", markersize=3, linewidth=0.8)
+        ax_run.set_title("Run Sequence Plot")
+        ax_run.set_xlabel("Run order")
+        ax_run.set_ylabel("Response")
+        ax_run.grid(True, alpha=0.3)
+        ax_lag.scatter(values[:-1], values[1:], s=12)
+        ax_lag.set_title("Lag Plot (lag 1)")
+        ax_lag.set_xlabel("Y(t)")
+        ax_lag.set_ylabel("Y(t+1)")
+        ax_lag.grid(True, alpha=0.3)
+        ax_hist.hist(values, bins="auto", edgecolor="black", linewidth=0.5)
+        ax_hist.set_title("Histogram")
+        ax_hist.set_xlabel("Response")
+        ax_hist.set_ylabel("Frequency")
+        ax_hist.grid(True, alpha=0.3)
+        (_osm, _osr), (_slope, _intercept, _r) = _stats.probplot(values, dist="norm")
+        ax_prob.scatter(_osm, _osr, s=12)
+        ax_prob.plot(_osm, _slope * _osm + _intercept, color="red", linewidth=1.2)
+        ax_prob.set_title("Normal Probability Plot")
+        ax_prob.set_xlabel("Theoretical quantiles")
+        ax_prob.set_ylabel("Ordered responses")
+        ax_prob.grid(True, alpha=0.3)
+        fig.suptitle(title)
+        fig.tight_layout()
+        STATIC_DIR.mkdir(parents=True, exist_ok=True)
+        save_path = str(plot_path_for("eda_4plot", np.asarray(data, dtype=float).tolist(), title))
+        fig.savefig(save_path, dpi=150, bbox_inches="tight")
+        plt.close(fig)
+    return {"file": save_path}
