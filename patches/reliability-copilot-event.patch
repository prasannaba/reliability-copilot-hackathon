+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.append(str(Path(__file__).resolve().parents[1]))
+
+from src.domains.reliability.growth_fit import (
+    crow_amsaa_fit,
+    duane_fit,
+    forecast_crow_amsaa,
+)
+
+
+def test_duane_positive_slope_means_growth():
+    # Synthetic growth: failures slow down → cumulative MTBF rises → Duane slope > 0
+    times = np.array([10.0, 30.0, 70.0, 150.0, 300.0, 600.0])
+    d = duane_fit(times)
+    assert d["alpha"] > 0  # positive growth rate
+    assert 0 < d["r_squared"] <= 1
+    assert d["K"] > 0
+
+
+def test_crow_amsaa_beta_less_than_one_for_growth():
+    times = np.array([10.0, 30.0, 70.0, 150.0, 300.0, 600.0])
+    fit = crow_amsaa_fit(times)
+    assert 0 < fit["beta"] < 1.5  # growth data should have beta near/below 1
+    assert fit["lambda"] > 0
+    assert fit["mtbf_instantaneous"] > 0
+
+
+def test_crow_amsaa_time_terminated():
+    times = np.array([10.0, 30.0, 70.0, 150.0])
+    fit = crow_amsaa_fit(times, time_terminated=200.0)
+    assert fit["termination"] == "time"
+    assert fit["T"] == 200.0
+    assert fit["n"] == 4
+
+
+def test_forecast_mtbf_increases_with_growth():
+    times = np.array([10.0, 30.0, 70.0, 150.0, 300.0, 600.0])
+    fit = crow_amsaa_fit(times)
+    early = forecast_crow_amsaa(fit, 600.0)
+    late = forecast_crow_amsaa(fit, 1200.0)
+    # For beta < 1 (growth), MTBF should increase with forecast horizon
+    if fit["beta"] < 1:
+        assert late["forecast_mtbf"] > early["forecast_mtbf"]
+
+
+def test_growth_requires_at_least_three_failures():
+    import pytest
+
+    with pytest.raises(ValueError, match="at least 3"):
+        duane_fit(np.array([10.0, 20.0]))
+    with pytest.raises(ValueError, match="at least 3"):
+        crow_amsaa_fit(np.array([10.0, 20.0]))
+
+
+def test_growth_rejects_non_finite_and_nonpositive():
+    import pytest
+
+    with pytest.raises(ValueError):
+        duane_fit(np.array([10.0, float("inf"), 30.0]))
+    with pytest.raises(ValueError):
+        crow_amsaa_fit(np.array([-5.0, 10.0, 20.0]))
+    with pytest.raises(ValueError):
+        crow_amsaa_fit(np.array([10.0, 20.0, 30.0]), time_terminated=-1)
+
+
+def test_tool_wrappers_validate_and_plot():
+    from src.domains.reliability.tools.growth import (
+        analyze_reliability_growth,
+        forecast_growth_mtbf,
+    )
+
+    result = analyze_reliability_growth([10.0, 30.0, 70.0, 150.0])
+    assert "duane" in result
+    assert "crow_amsaa" in result
+    assert "file" in result
+    assert result["file"].endswith(".png")
+
+    forecast = forecast_growth_mtbf([10.0, 30.0, 70.0, 150.0], forecast_time=300.0)
+    assert "forecast" in forecast
+    assert forecast["forecast"]["forecast_mtbf"] > 0
