+"""Distribution fitting/selection tools (plain fns; registered in server.py)."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+from src.domains.reliability.distributions import fit_family, rank_families
+from src.domains.reliability.nonparametric import kaplan_meier
+from src.domains.reliability.plotting import plot_distribution_comparison
+from src.domains.reliability.tools._common import json_safe
+
+_OVERLAY_TOP_N = 4
+
+
+def _cue_agreement(cue: str, ranking: list[dict[str, Any]]) -> str:
+    """Check the KM hazard-shape cue against the top-ranked family."""
+    if cue == "undetermined":
+        return "unresolved — too few distinct event times for a hazard-shape cue"
+    best = ranking[0]["family"]
+    params = ranking[0]["params"]
+    if cue == "approximately-constant":
+        return "agree" if best == "exponential" else "unresolved — KM looks flat but AIC prefers " + best
+    if cue == "increasing":
+        if best in {"lognormal", "loglogistic", "normal", "logistic"}:
+            return "agree"
+        if best == "weibull" and params.get("beta", 0) > 1.0:
+            return "agree"
+        return "unresolved — KM hazard rises but AIC prefers " + best
+    if best == "weibull" and params.get("beta", 1) < 1.0:
+        return "agree"
+    if best == "exponential":
+        return "unresolved — KM hazard falls but AIC prefers exponential"
+    return "unresolved — inspect the KM overlay before committing"
+
+
+def fit_life_distribution(
+    family: str,
+    failure_times: list[float],
+    censored_times: list[float] | None = None,
+) -> dict[str, Any]:
+    """Right-censored MLE for one life-distribution family with AIC."""
+    return json_safe(fit_family(family, failure_times, censored_times))
+
+
+def select_life_distribution(
+    failure_times: list[float],
+    censored_times: list[float] | None = None,
+    candidates: list[str] | None = None,
+    selection: str = "single",
+    title: str = "Distribution Comparison vs Kaplan-Meier",
+) -> dict[str, Any]:
+    """Rank candidate families by AIC with a KM hazard-shape cue.
+
+    selection='single' commits to the lowest-AIC family; selection='multi'
+    returns the ranked shortlist for comparison (selected is null).
+    """
+    mode = (selection or "single").strip().lower()
+    if mode not in {"single", "multi"}:
+        raise ValueError("selection must be 'single' or 'multi'")
+    ranking = rank_families(failure_times, censored_times, candidates)
+    km = kaplan_meier(failure_times, censored_times)
+    cue = km["hazard_shape_cue"]
+    overlay = plot_distribution_comparison(km, ranking[:_OVERLAY_TOP_N], title)
+
+    warnings: list[str] = []
+    if ranking[0].get("fallback_to_complete_data"):
+        warnings.append(
+            f"{ranking[0]['family']} censored fit did not converge — "
+            "reported params are the complete-data fallback"
+        )
+    if km["n_failures"] < 5:  # noqa: PLR2004
+        warnings.append(
+            "fewer than 5 failures (rule-of-thumb small sample) — "
+            "AIC ranking is unstable; collect more data before committing"
+        )
+
+    result: dict[str, Any] = {
+        "selection": mode,
