@@ -0,0 +1,118 @@
+"""Growth plots: Duane log-log + Crow-AMSAA cumulative failures.
+
+Deterministic plotting — no LLM.  Saves PNGs to ``STATIC_DIR``.
+"""
+
+from __future__ import annotations
+
+import warnings
+from typing import Any
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+
+from src.domains.reliability.growth_fit import crow_amsaa_fit, duane_fit
+from src.domains.reliability.tools._common import STATIC_DIR, plot_path_for
+
+try:
+    from numpy.exceptions import RankWarning as _RankWarning
+except ImportError:
+    from numpy import RankWarning as _RankWarning  # type: ignore[no-redef,attr-defined]
+
+warnings.filterwarnings("ignore", category=_RankWarning)
+warnings.filterwarnings(
+    "ignore",
+    message="This figure includes Axes that are not compatible with tight_layout.*",
+    category=UserWarning,
+)
+
+
+def plot_growth_analysis(
+    failure_times: np.ndarray,
+    title: str = "Reliability Growth Analysis",
+    time_terminated: float | None = None,
+) -> dict[str, Any]:
+    """Create Duane + Crow-AMSAA growth plots and return fit results.
+
+    Returns dict with duane/crow fits, file (PNG path), and message.
+    """
+    t = np.asarray(failure_times, dtype=float).ravel()
+    duane = duane_fit(t)
+    crow = crow_amsaa_fit(t, time_terminated=time_terminated)
+
+    crow_beta = crow["beta"]
+    crow_lambda = crow["lambda"]
+    T = crow["T"]
+
+    fig, axes = plt.subplots(1, 2, figsize=(12, 5))
+    ax1, ax2 = axes
+
+    # Panel 1: Duane plot (log-log cumulative MTBF vs cumulative time)
+    x = duane["x"]
+    y = duane["y"]
+    y_hat = duane["y_hat"]
+    ax1.plot(np.exp(x), np.exp(y), "o", color="steelblue", label="Observed cum. MTBF")
+    ax1.plot(
+        np.exp(x),
+        np.exp(y_hat),
+        "-",
+        color="darkorange",
+        linewidth=2,
+        label=f"Duane fit (α={duane['alpha']:.3f}, R²={duane['r_squared']:.3f})",
+    )
+    ax1.set_xscale("log")
+    ax1.set_yscale("log")
+    ax1.set_xlabel("Cumulative time (hours, log scale)")
+    ax1.set_ylabel("Cumulative MTBF (hours, log scale)")
+    ax1.set_title("Duane Plot")
+    ax1.legend(fontsize=8)
+    ax1.grid(True, which="both", ls="--", alpha=0.4)
+
+    # Panel 2: Cumulative failures vs time with Crow-AMSAA mean value
+    n = crow["n"]
+    ax2.plot(t, np.arange(1, n + 1), "o", color="steelblue", label="Observed failures")
+    t_grid = np.linspace(t[0] * 0.9, T * 1.05, 100)
+    mean_grid = crow_lambda * t_grid**crow_beta
+    ax2.plot(
+        t_grid,
+        mean_grid,
+        "-",
+        color="darkorange",
+        linewidth=2,
+        label=f"Crow-AMSAA (β={crow_beta:.3f}, λ={crow_lambda:.2e})",
+    )
+    ax2.set_xlabel("Cumulative time (hours)")
+    ax2.set_ylabel("Cumulative failures")
+    ax2.set_title("Crow-AMSAA Mean Value")
+    ax2.legend(fontsize=8)
+    ax2.grid(True, ls="--", alpha=0.4)
+
+    # Summary annotation
+    growth_label = "growth" if crow_beta < 1 else "no growth" if crow_beta == 1 else "deterioration"
+    fig.suptitle(
+        f"{title}  —  β={crow_beta:.3f} ({growth_label}), MTBF_inst={crow['mtbf_instantaneous']:.1f} h",
+        fontsize=10,
+    )
+    fig.tight_layout()
+
+    STATIC_DIR.mkdir(parents=True, exist_ok=True)
+    save_path = str(
+        plot_path_for(
+            "growth_plot",
+            np.asarray(failure_times, dtype=float).ravel().tolist(),
+            time_terminated,
+            title,
+        )
+    )
+    fig.savefig(save_path, dpi=150, bbox_inches="tight")
+    plt.close(fig)
+
+    return {
+        "file": save_path,
+        "duane": {k: v for k, v in duane.items() if k not in ("x", "y", "y_hat", "cum_mtbf", "t")},
+        "crow_amsaa": {k: v for k, v in crow.items()},
+        "message": f"Growth plot saved as {save_path}",
+    }
