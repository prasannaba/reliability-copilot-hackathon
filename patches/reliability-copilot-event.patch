+"""ReAct / <think> reasoning parsing (extracted from app.py).
+
+The LLM may emit ReAct traces (``Thought: ... Final Answer: ...``) or
+``<think>`` blocks.  This module isolates that parsing so ``app.py`` stays
+focused on HTTP wiring.  All behaviour is identical to the pre-split
+implementation — tests import from ``src.host.app`` via re-export.
+"""
+
+from __future__ import annotations
+
+import re
+
+_FINAL_ANSWER = re.compile(r"(?:^|\n)\s*(?:Final\s+Answer|Answer)\s*:\s*", re.IGNORECASE)
+_THOUGHT_HEAD = re.compile(r"\A\s*Thought\s*:", re.IGNORECASE)
+_THINK_TAG = re.compile(r"<think>(.*?)</think>", re.IGNORECASE | re.DOTALL)
+_THINK_OPEN = re.compile(r"<think>", re.IGNORECASE)
+_THINK_CLOSE = re.compile(r"</think>", re.IGNORECASE)
+# Model scaffolding dialect (e.g. meta-spark): <|start|> control tokens,
+# `assistant to=<name>` role headers, and Thought:/Action:/Action Input:
+# tool-call lines. Only treated as scaffolding once such tokens appear, so
+# plain ReAct text and reliability prose keep the legacy behavior.
+_SCAFFOLD_TOKEN = re.compile(r"<\|.+?\|>")
+_ROLE_HEADER = re.compile(r"assistant to=[A-Za-z0-9_-]+(?=<|$)")
+_SEGMENT_HEAD = re.compile(r"<\|start\|>assistant to=([A-Za-z0-9_-]+)<\|message\|>")
+_ANSWER_ROLES = frozenset({"user", "assistant", "commentary"})
+_THOUGHT_LINE = re.compile(r"^\s*Thought\s*:", re.IGNORECASE)
+_ACTION_INPUT_LINE = re.compile(r"^\s*Action Input\s*:", re.IGNORECASE)
+_ACTION_TOOL_CALL = re.compile(r"^\s*Action\s*:\s*([A-Za-z][A-Za-z0-9_]*)(.*)$")
+_PARTIAL_HOLD = re.compile(r"^\s*(\w{1,24}|assistant.*|<\|.*)$")
+_ACTION_COLON = re.compile(r"^\s*Action\s*:(.*)$", re.IGNORECASE)
+
+
+def _is_scaffold_line(line: str) -> bool:
+    """True for Thought:/Action Input: lines and tool-call Action: lines."""
+    text = line.strip()
+    if not text:
+        return False
+    if _THOUGHT_LINE.match(text) or _ACTION_INPUT_LINE.match(text):
+        return True
+    tool_call = _ACTION_TOOL_CALL.match(text)
+    if tool_call:
+        rest = tool_call.group(2).strip()
+        return not rest or rest.startswith("Action Input")
+    return False
+
+
+def _hold_partial(partial: str) -> bool:
+    """Hold a trailing fragment that could still become scaffolding."""
+    if _PARTIAL_HOLD.match(partial):
+        return True
+    stripped = partial.strip()
+    if _THOUGHT_LINE.match(stripped) or _ACTION_INPUT_LINE.match(stripped):
+        return True
+    if re.match(r"^\s*(Thought|Action)\s*$", stripped, re.IGNORECASE):
+        return True
+    colon = _ACTION_COLON.match(stripped)
+    if colon:
+        return not re.search(r"\s", colon.group(1).strip())
+    return False
+
+
+def _partition_scaffolding(text: str) -> tuple[str, str]:
+    """Split model scaffolding out of a reply. Returns (thought, cleaned).
+
+    Parses the ``<|start|>assistant to=<name><|message|>`` envelope dialect:
+    tool payloads move to thought, commentary/user payloads stay visible
+    (consecutive duplicates collapsed). Bare scaffolding lines outside
+    envelopes are routed the same way. Lone ``Action:`` prose stays in the
+    answer. Returns ("", text) when no scaffolding is found.
+    """
+    raw = str(text or "")
+    if "<|" not in raw and "assistant to=" not in raw:
+        return "", text
+    thought: list[str] = []
+    answer: list[str] = []
+    last = [""]
+
+    def emit_chunk(chunk: str) -> None:
+        for piece in chunk.split("\n"):
+            s = piece.strip()
+            if not s:
+                answer.append(piece)
+            elif _is_scaffold_line(piece):
+                thought.append(s)
+            elif s == last[0]:
+                continue
+            else:
+                last[0] = s
+                answer.append(piece)
+
+    pieces = _SEGMENT_HEAD.split(raw)
+    emit_chunk(_SCAFFOLD_TOKEN.sub("", _ROLE_HEADER.sub("", pieces[0])))
+    idx = 1
+    while idx < len(pieces):
+        name = pieces[idx].lower()
+        payload = _SCAFFOLD_TOKEN.sub("", pieces[idx + 1] if idx + 1 < len(pieces) else "")
+        if name in _ANSWER_ROLES:
+            if payload.strip() and payload.strip() == last[0]:
+                pass
+            else:
+                emit_chunk(payload)
+        elif payload.strip():
+            thought.append(payload.strip())
+        idx += 2
+    cleaned = "\n".join(answer).strip()
+    if not thought and cleaned == raw.strip():
+        return "", text
+    return "\n".join(thought).strip(), cleaned
+
+
+def _join_thoughts(*parts: str) -> str:
+    return "\n\n".join(part.strip() for part in parts if part and part.strip())
+
+
+def split_thinking_from_answer(text: str) -> tuple[str, str]:
+    scaf_thought, rest = _partition_scaffolding(text)
+    thought, answer = _split_react_thinking(rest)
+    return _join_thoughts(scaf_thought, thought), answer
+
+
+def _split_react_thinking(raw: str) -> tuple[str, str]:
+    """Legacy ReAct/<think> split over already-descaffolded text.
+
+    Only a leading ``Thought:`` (or ``<think>`` tags) counts as reasoning.
+    Reliability markdown often contains ``Observation:`` or ``Action:`` and
+    must stay in the answer.
+    """
+    raw = str(raw or "")
+    tagged = [chunk.strip() for chunk in _THINK_TAG.findall(raw) if chunk.strip()]
+    rest = _THINK_TAG.sub("", raw)
+    match = _FINAL_ANSWER.search(rest)
+    prefix = rest[: match.start()] if match else ""
+    if match and _THOUGHT_HEAD.search(prefix):
+        return _join_thoughts(*tagged, prefix.strip()), rest[match.end() :].strip()
+    if _THOUGHT_HEAD.search(rest):
+        return _join_thoughts(*tagged, rest.strip()), ""
+    return _join_thoughts(*tagged), rest.strip()
+
+
+class StreamThoughtSplitter:
+    """Classify streamed tokens as thinking vs answer without waiting for the full reply."""
+
+    def __init__(self) -> None:
+        self.mode = "unknown"
+        self.buffer = ""
+        self._in_think_tag = False
+        self._saw_scaffolding = False
+        self._last_answer_line = ""
+        self._last_answer_block = ""
+
+    def feed(self, delta: str) -> list[tuple[str, str]]:
+        if not delta:
+            return []
+        # Route on any "<|" fragment (not just a complete segment head): the
+        # generic path below strips "<|...|>" tokens, which would destroy a
+        # split "<|start|>" delimiter before the segment parser can use it and
+        # leave a bare "assistant to=<name>" header no regex can match. Check
+        # the concatenation so a marker split across chunks still matches.
+        combined = self.buffer + delta
+        if not self._in_think_tag and ("<|" in combined or "assistant to=" in combined):
+            self._saw_scaffolding = True
+            self.buffer += delta
+            return [(kind, text) for kind, text in self._drain_segments() if text]
+        if self.mode == "answer" and not self._in_think_tag and not self._saw_scaffolding:
+            return [("token", delta)]
+
+        self.buffer += delta
+        cleaned, n_tokens = _SCAFFOLD_TOKEN.subn("", self.buffer)
+        if n_tokens:
+            self._saw_scaffolding = True
+            self.buffer = cleaned
+        if self.mode == "answer" and not self._in_think_tag and self._saw_scaffolding:
+            return [(kind, text) for kind, text in self._drain_answer_lines() if text]
+        events: list[tuple[str, str]] = []
+
+        while self.buffer:
+            if self._in_think_tag:
+                close = _THINK_CLOSE.search(self.buffer)
+                if not close:
+                    events.append(("thought", self.buffer))
+                    self.buffer = ""
+                    break
+                events.append(("thought", self.buffer[: close.start()]))
+                self.buffer = self.buffer[close.end() :]
+                self._in_think_tag = False
+                continue
+
+            open_tag = _THINK_OPEN.search(self.buffer)
+            if open_tag:
+                if open_tag.start() > 0:
+                    prefix = self.buffer[: open_tag.start()]
+                    events.extend(self._classify_prefix(prefix))
+                self.buffer = self.buffer[open_tag.end() :]
+                self._in_think_tag = True
+                continue
+
+            final = _FINAL_ANSWER.search(self.buffer)
+            if final:
+                thought = self.buffer[: final.start()]
+                answer = self.buffer[final.end() :]
+                if self.mode == "thought" or _THOUGHT_HEAD.search(thought) or not thought.strip():
+                    if thought.strip():
+                        events.append(("thought", thought))
+                    self.buffer = ""
+                    self.mode = "answer"
+                    if answer:
+                        events.append(("token", answer))
+                    break
+
+            if self.mode == "thought":
+                events.append(("thought", self.buffer))
+                self.buffer = ""
+                break
+
+            if self.mode == "unknown":
+                if _THOUGHT_HEAD.search(self.buffer):
+                    self.mode = "thought"
+                    events.append(("thought", self.buffer))
+                    self.buffer = ""
+                    break
+                if "\n" in self.buffer or len(self.buffer) >= 80:
+                    self.mode = "answer"
+                    events.append(("token", self.buffer))
+                    self.buffer = ""
+                    break
+                break
+            break
