+
+    def _emit_answer_text(self, text: str, events: list[tuple[str, str]]) -> None:
+        """Classify complete text: scaffolding lines to thought, rest to tokens."""
+        for chunk in text.splitlines(keepends=True):
+            s = chunk.strip()
+            if not s:
+                events.append(("token", chunk))
+            elif _is_scaffold_line(chunk):
+                events.append(("thought", s))
+            else:
+                events.append(("token", chunk))
+
+    def _drain_segments(self, final: bool = False) -> list[tuple[str, str]]:
+        """Emit complete envelope segments; tool payloads become thought."""
+        events: list[tuple[str, str]] = []
+        for _round in range(100):
