+class _FakeAgent:
+    """Replays one event script per run() call; records user messages."""
+
+    def __init__(self, scripts, finals=None):
+        self._scripts = scripts
+        self._finals = finals or ["final answer"] * len(scripts)
+        self.calls = []
+
+    def run(self, user_msg=None, ctx=None):
+        self.calls.append(user_msg)
+        index = min(len(self.calls) - 1, len(self._scripts) - 1)
+        return _FakeHandler(self._scripts[index], self._finals[index])
+
+class _FakeToolCall:
+    def __init__(self, tool_name):
+        self.tool_name = tool_name
+
+class _FakeToolCallResult:
+    def __init__(self, tool_name):
+        self.tool_name = tool_name
+        self.tool_output = "{}"
+
+class _FakeHandler:
+    def __init__(self, events, final="final answer"):
+        self._events = events
+        self._final = final
+
+    def stream_events(self):
+        async def gen():
+            for event in self._events:
+                yield event
+
+        return gen()
+
+    def __await__(self):
+        async def done():
+            return self._final
+
+        return done().__await__()
+
+def _event_loop_available() -> bool:
+    """Sandboxed runs block the socketpair every asyncio loop needs."""
+    import asyncio
+
+    try:
+        loop = asyncio.DefaultEventLoopPolicy().new_event_loop()
+    except OSError:
+        return False
+    try:
+        loop.close()
+    except Exception:
+        pass
+    return True
+
+needs_loop = pytest.mark.skipif(
+    not _event_loop_available(), reason="sandbox blocks asyncio socketpair"
+)
