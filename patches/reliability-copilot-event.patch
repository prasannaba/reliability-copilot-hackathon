+            prefix = self.buffer[: match.start()]
+            self.buffer = self.buffer[match.start():]
+            match = _SEGMENT_HEAD.match(self.buffer)
+            assert match is not None
+            if prefix.strip():
+                self._emit_answer_text(_ROLE_HEADER.sub("", _SCAFFOLD_TOKEN.sub("", prefix)), events)
+            rest = self.buffer[match.end():]
+            nxt = rest.find("<|start|>")
+            if nxt != -1:
+                payload, self.buffer = rest[:nxt], rest[nxt:]
+            else:
+                close = re.search(r"<\|(?:eom|eot|end)\|>", rest)
+                if not close:
