+import { describe, expect, it } from 'vitest';
+import { act, renderHook } from '@testing-library/react';
+import { useSessions } from './useSessions';
+import type { Storage } from '../services/types';
+
+function fakeStorage(): Storage & { writes: string[] } {
+  const store = new Map<string, string>();
+  const writes: string[] = [];
+  return {
+    writes,
+    getItem: (key: string) => store.get(key) ?? null,
+    setItem: (key: string, value: string) => {
+      writes.push(key);
+      store.set(key, value);
+    },
+    removeItem: (key: string) => {
+      store.delete(key);
+    },
+  };
+}
+
+describe('persist deferral', () => {
+  it('skips storage writes while streaming, persists once it ends', () => {
+    const storage = fakeStorage();
+    const { result, rerender } = renderHook(({ streaming }) => useSessions(storage, streaming), {
+      initialProps: { streaming: true },
+    });
+    const initialWrites = storage.writes.length;
+    act(() => {
+      result.current.setMessages((prev) => [
+        ...prev,
+        { id: 'm1', role: 'assistant', content: 'streaming…', timestamp: 1 },
+      ]);
+    });
+    expect(storage.writes.length).toBe(initialWrites);
+    rerender({ streaming: false });
+    expect(storage.writes).toContain('reliability-copilot-sessions');
+    expect(storage.getItem('reliability-copilot-sessions')).toContain('streaming…');
+  });
+
+  it('persists normally when never streaming', () => {
+    const storage = fakeStorage();
+    const { result } = renderHook(() => useSessions(storage, false));
+    act(() => {
+      result.current.setMessages((prev) => [
+        ...prev,
+        { id: 'm1', role: 'user', content: 'hi', timestamp: 1 },
+      ]);
+    });
+    expect(storage.getItem('reliability-copilot-sessions')).toContain('hi');
+  });
+});
