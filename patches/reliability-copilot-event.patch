@@ -0,0 +1,187 @@
+"""Weibull paper layout: y tick labels survive twiny; title clears the beta band."""
+
+import sys
+from pathlib import Path
+
+sys.path.append(str(Path(__file__).resolve().parents[1]))
+
+import matplotlib.pyplot as plt
+import numpy as np
+from matplotlib.gridspec import GridSpec
+
+from src.domains.reliability import plotting
+from src.domains.reliability.plotting import weibull_probability_paper
+
+
+def _paper(title="Weibull Probability Plot"):
+    fig = plt.figure(figsize=(8.5, 11))
+    gs = GridSpec(
+        nrows=2, ncols=2, figure=fig, height_ratios=[3, 1],
+        top=0.88, bottom=0.10, left=0.13, right=0.93,
+    )
+    ax = fig.add_subplot(gs[0, :])
+    parts = weibull_probability_paper(ax, title, 20.0, 2000.0)
+    parts[4]()  # draw_band()
+    fig.canvas.draw()
+    return fig, ax
+
+
+def test_y_tick_labels_present():
+    fig, ax = _paper()
+    try:
+        labels = [t.get_text() for t in ax.get_yticklabels()]
+        assert any(labels), "y-axis tick labels missing on Weibull paper"
+        assert "0.10" in labels
+        assert "99.9" in labels
+        assert "100" not in labels
+    finally:
+        plt.close(fig)
+
+
+def test_title_clears_beta_band():
+    fig, ax = _paper()
+    try:
+        r = ax.get_position()
+        band_top = r.y1 + 0.028
+        inv = fig.transFigure.inverted()
+        (_x0, y0), (_x1, _y1) = inv.transform(ax.title.get_window_extent())
+        assert y0 > band_top, "title overlaps the beta band"
+    finally:
+        plt.close(fig)
+
+
+def test_fit_text_clears_legend_with_suspensions(tmp_path, monkeypatch):
+    import matplotlib.pyplot as plt
+
+    monkeypatch.setattr(plotting, "STATIC_DIR", tmp_path)
+    figs = []
+    real_figure = plt.figure
+    real_close = plt.close
+    monkeypatch.setattr(
+        plt, "figure", lambda *a, **k: (figs.append(real_figure(*a, **k)), figs[-1])[1]
+    )
+    monkeypatch.setattr(plt, "close", lambda *a, **k: None)
+    try:
+        plotting.plot_weibull_analysis([54, 187, 240], censored_times=[500, 500])
+        assert figs, "expected the analysis to build a figure"
+        fig = figs[-1]
+        fig.canvas.draw()
+        ax = fig.axes[0]
+        inv = fig.transFigure.inverted()
+        leg = ax.get_legend()
+        (_lx0, _ly0), (_lx1, ly1) = inv.transform(
+            leg.get_window_extent(fig.canvas.get_renderer())
+        )
+        fit = next(t for t in ax.texts if t.get_text().startswith("Goodness of fit"))
+        (_fx0, fy0), (_fx1, _fy1) = inv.transform(fit.get_window_extent())
+        assert fy0 > ly1, "fit box overlaps the legend"
+    finally:
+        for f in figs:
+            real_close(f)
+
+
+def test_beta_line_stays_below_band(tmp_path, monkeypatch):
+    import matplotlib.pyplot as plt
+
+    monkeypatch.setattr(plotting, "STATIC_DIR", tmp_path)
+    figs = []
+    real_figure = plt.figure
+    real_close = plt.close
+    monkeypatch.setattr(
+        plt, "figure", lambda *a, **k: (figs.append(real_figure(*a, **k)), figs[-1])[1]
+    )
+    monkeypatch.setattr(plt, "close", lambda *a, **k: None)
+    try:
+        plotting.plot_weibull_analysis([54, 187, 240], censored_times=[500, 500])
+        assert figs, "expected the analysis to build a figure"
+        fig = figs[-1]
+        fig.canvas.draw()
+        ax = fig.axes[0]
+        line = next(
+            ln for ln in ax.get_lines() if (ln.get_label() or "").startswith("β line")
+        )
+        assert len(line.get_ydata()) == 2
+        # Top endpoint plus half the linewidth must stay below the band,
+        # whose bottom edge is the axes top.
+        r = ax.get_position()
+        top_data = float(max(line.get_ydata()))
+        disp = ax.transData.transform((line.get_xdata()[1], top_data))
+        _fx, fy = fig.transFigure.inverted().transform(disp)
+        half_lw_frac = (line.get_linewidth() / 2) / (fig.get_size_inches()[1] * 72)
+        assert fy + half_lw_frac < r.y1, "beta line spills into the beta band"
+    finally:
+        for f in figs:
+            real_close(f)
+
+
+def test_confidence_artists_capped_below_spine(tmp_path, monkeypatch):
+    import matplotlib.pyplot as plt
+
+    monkeypatch.setattr(plotting, "STATIC_DIR", tmp_path)
+    figs = []
+    real_figure = plt.figure
+    real_close = plt.close
+    monkeypatch.setattr(
+        plt, "figure", lambda *a, **k: (figs.append(real_figure(*a, **k)), figs[-1])[1]
+    )
+    monkeypatch.setattr(plt, "close", lambda *a, **k: None)
+    try:
+        plotting.plot_weibull_analysis([54, 187, 240], censored_times=[500, 500])
+        assert figs, "expected the analysis to build a figure"
+        fig = figs[-1]
+        fig.canvas.draw()
+        ax = fig.axes[0]
+        r = ax.get_position()
+        fig_h_pt = fig.get_size_inches()[1] * 72
+        inv = fig.transFigure.inverted()
+        checked = 0
+        for ln in ax.get_lines():
+            label = ln.get_label() or ""
+            if label.startswith("_") or not len(ln.get_ydata()):
+                continue
+            ys = np.asarray(ln.get_ydata(), dtype=float)
+            xs = np.asarray(ln.get_xdata(), dtype=float)
+            _fx, fy = inv.transform(ax.transData.transform((xs[int(np.argmax(ys))], float(ys.max()))))
+            margin = (ln.get_linewidth() / 2) / fig_h_pt
+            assert fy + margin < r.y1, f"{label} reaches the top spine"
+            checked += 1
+        assert checked >= 3  # fitted line, beta line, eta crosshair at minimum
+        for col in ax.collections:
+            verts = col.get_paths()[0].vertices
+            fy_max = inv.transform(ax.transData.transform(verts))[:, 1].max()
+            assert fy_max < r.y1, "fill reaches the top spine"
+    finally:
+        for f in figs:
+            real_close(f)
+
+
+def test_beta_eta_share_margin_column(tmp_path, monkeypatch):
+    import matplotlib.pyplot as plt
+
+    monkeypatch.setattr(plotting, "STATIC_DIR", tmp_path)
+    figs = []
+    real_figure = plt.figure
+    real_close = plt.close
+    monkeypatch.setattr(
+        plt, "figure", lambda *a, **k: (figs.append(real_figure(*a, **k)), figs[-1])[1]
+    )
+    monkeypatch.setattr(plt, "close", lambda *a, **k: None)
+    try:
+        plotting.plot_weibull_analysis([54, 187, 240], censored_times=[500, 500])
+        assert figs, "expected the analysis to build a figure"
+        fig = figs[-1]
+        fig.canvas.draw()
+        ax = fig.axes[0]
+        r = ax.get_position()
+        inv = fig.transFigure.inverted()
+        beta = next(t for t in fig.texts if t.get_text() == "β")
+        eta = next(t for t in ax.texts if t.get_text() == "η")
+        beta_x, _beta_y = beta.get_position()
+        eta_disp = ax.transAxes.transform(eta.xy)
+        eta_x, _eta_y = inv.transform(eta_disp)
+        assert beta_x > r.x1, "beta symbol is not outside the graph"
+        assert eta_x > r.x1, "eta label is not outside the graph"
+        assert abs(beta_x - eta_x) < 0.002, "beta and eta are not in one margin column"
+    finally:
+        for f in figs:
+            real_close(f)
