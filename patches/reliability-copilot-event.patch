+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+sys.path.append(str(Path(__file__).resolve().parents[1]))
+
+from src.domains.reliability import distributions as dist
+from src.domains.reliability import nonparametric as km_mod
+from src.domains.reliability.tools import distributions as dist_tools
+from src.domains.reliability.tools._common import STATIC_DIR
+
+
+def test_kaplan_meier_hand_computed():
+    km = km_mod.kaplan_meier([4.0, 6.0, 8.0], [10.0])
+    assert km["times"] == [4.0, 6.0, 8.0, 10.0]
+    assert km["survival"] == pytest.approx([0.75, 0.5, 0.25, 0.25])
+    assert km["median"] == pytest.approx(6.0)
+    assert km["n_failures"] == 3
+    assert km["n_censored"] == 1
+
+
+def test_kaplan_meier_ties_apply_failures_first():
+    km = km_mod.kaplan_meier([5.0, 5.0], [5.0])
+    assert km["survival"] == pytest.approx([1.0 / 3.0])
+    assert km["median"] == pytest.approx(5.0)
+
+
+def test_kaplan_meier_rejects_bad_inputs():
+    with pytest.raises(ValueError):
+        km_mod.kaplan_meier([])
+    with pytest.raises(ValueError):
+        km_mod.kaplan_meier([-1.0, 2.0])
+    with pytest.raises(ValueError):
+        km_mod.kaplan_meier([1.0], [-2.0])
+
+
+def test_hazard_cue_detects_wear_out():
+    rng = np.random.default_rng(0)
+    sample = 100.0 * (-np.log1p(-rng.random(30))) ** (1.0 / 2.5)
+    km = km_mod.kaplan_meier(sample)
+    assert km["hazard_shape_cue"]["hazard"] == "increasing"
+
+
+def test_exponential_fit_matches_sample_mean():
+    rng = np.random.default_rng(1)
+    sample = rng.exponential(scale=50.0, size=30)
+    fit = dist.fit_family("exponential", sample)
+    assert fit["params"]["lambda"] == pytest.approx(float(np.mean(sample)), rel=0.02)
+    assert fit["aic"] == pytest.approx(2 - 2 * fit["loglik"])
+
+
+def test_lognormal_fit_recovers_sigma():
+    rng = np.random.default_rng(2)
+    sample = rng.lognormal(mean=np.log(100.0), sigma=0.5, size=200)
+    fit = dist.fit_family("lognormal", sample)
+    assert fit["params"]["sigma"] == pytest.approx(0.5, abs=0.06)
+
+
+def test_rank_prefers_true_family():
+    rng = np.random.default_rng(7)
+    sample = rng.exponential(scale=50.0, size=40)
+    ranked = dist.rank_families(sample, None, ["weibull", "exponential", "normal"])
+    assert ranked[0]["family"] == "exponential"
+    assert [f["delta_aic"] for f in ranked] == sorted(f["delta_aic"] for f in ranked)
+    assert ranked[0]["delta_aic"] == pytest.approx(0.0)
+
+
+def test_rank_handles_censoring_and_aliases():
+    rng = np.random.default_rng(4)
+    sample = 100.0 * (-np.log1p(-rng.random(40))) ** (1.0 / 2.5)
+    ranked = dist.rank_families(sample, [150.0, 150.0, 150.0], ["Weibull", "sev"])
+    assert ranked[0]["family"] == "weibull"
+    assert {f["family"] for f in ranked} == {"weibull", "gumbel-sev"}
+
+
+def test_rank_rejects_bad_inputs():
+    with pytest.raises(ValueError):
+        dist.rank_families([1.0], None, ["weibull"])
+    with pytest.raises(ValueError):
+        dist.rank_families([1.0, 2.0], None, ["gumbel-bogus"])
+    with pytest.raises(ValueError):
+        dist.rank_families([1.0, 2.0], None, [])
+
+
+def test_select_single_commits_with_plot():
+    rng = np.random.default_rng(5)
+    sample = rng.exponential(scale=50.0, size=30)
+    result = dist_tools.select_life_distribution(sample.tolist(), None, ["exponential", "weibull"], "single")
+    assert result["selection"] == "single"
+    assert result["selected"] == "exponential"
+    assert "lowest AIC" in result["selection_rationale"]
+    assert result["comparison_plot"].endswith(".png")
+    assert (STATIC_DIR / result["comparison_plot"]).is_file()
+
+
+def test_select_multi_returns_shortlist_without_commit():
+    rng = np.random.default_rng(6)
+    sample = rng.exponential(scale=50.0, size=30)
+    result = dist_tools.select_life_distribution(sample.tolist(), None, None, "multi")
+    assert result["selection"] == "multi"
+    assert result["selected"] is None
+    assert len(result["ranking"]) == len(dist.CANDIDATE_FAMILIES)
+    assert "compare" in result["selection_rationale"]
+    with pytest.raises(ValueError):
+        dist_tools.select_life_distribution(sample.tolist(), None, None, "bogus")
