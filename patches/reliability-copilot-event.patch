+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+function stubFetch(captured: string[]) {
+  vi.stubGlobal(
+    'fetch',
+    async (_url: unknown, init?: RequestInit) => {
+      captured.push(String(init?.body ?? ''));
+      return new Response('', { status: 200 });
+    },
+  );
+}
+
+describe('streamMessage body', () => {
+  it('sends no mode key (single reliability domain)', async () => {
+    const captured: string[] = [];
+    stubFetch(captured);
+    await createHttpApi({}).streamMessage('estimate B10', () => {});
+    expect(captured).toHaveLength(1);
+    expect(JSON.parse(captured[0])).toMatchObject({ prompt: 'estimate B10' });
+    expect('mode' in JSON.parse(captured[0])).toBe(false);
+  });
+
+  it('posts transcript history when provided', async () => {
+    const captured: string[] = [];
+    stubFetch(captured);
+    await createHttpApi({}).streamMessage('Implement', () => {}, undefined, undefined, true, 'medium', [
+      { role: 'user', content: 'Fit Weibull' },
+      { role: 'assistant', content: 'Plan ready' },
+    ]);
+    expect(captured).toHaveLength(1);
