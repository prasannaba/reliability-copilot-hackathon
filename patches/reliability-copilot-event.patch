+"""Growth MCP tool wrappers (plain functions; registered in server.py)."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from src.domains.reliability.growth_fit import crow_amsaa_fit, duane_fit, forecast_crow_amsaa
+from src.domains.reliability.growth_plot import plot_growth_analysis
+from src.domains.reliability.tools._common import PLOT_LOCK, json_safe
+
+
+def analyze_reliability_growth(
+    failure_times: list[float],
+    title: str = "Reliability Growth Analysis",
+    time_terminated: float | None = None,
+) -> dict[str, Any]:
+    """Fit Duane + Crow-AMSAA to failure times, plot, and return fit statistics."""
+    if len(failure_times) < 3:
+        raise ValueError("at least 3 failure times are required for growth analysis")
+    if any(v <= 0 for v in failure_times):
+        raise ValueError("failure times must be greater than zero")
+    if time_terminated is not None and time_terminated <= 0:
+        raise ValueError("time_terminated must be positive when provided")
+
+    with PLOT_LOCK:
+        result = plot_growth_analysis(
+            np.asarray(failure_times, dtype=float),
+            title=title,
+            time_terminated=time_terminated,
+        )
+
+    normalized = {key: json_safe(value) for key, value in result.items()}
+    plot_path = Path(normalized["file"])
+    normalized["file"] = plot_path.name
+    normalized["message"] = f"Growth plot saved as {plot_path.name}"
+    return normalized
+
+
+def forecast_growth_mtbf(
+    failure_times: list[float],
+    forecast_time: float,
+    time_terminated: float | None = None,
+) -> dict[str, Any]:
+    """Forecast instantaneous MTBF at a future cumulative time via Crow-AMSAA."""
+    if not failure_times or len(failure_times) < 3:
+        raise ValueError("at least 3 failure times are required")
+    if forecast_time <= 0 or not np.isfinite(forecast_time):
+        raise ValueError("forecast_time must be positive and finite")
+    fit = crow_amsaa_fit(np.asarray(failure_times, dtype=float), time_terminated=time_terminated)
+    forecast = forecast_crow_amsaa(fit, forecast_time)
+    return {
+        "fit": {k: json_safe(v) for k, v in fit.items()},
+        "forecast": {k: json_safe(v) for k, v in forecast.items()},
+    }
+
+
+# Keep tool helpers importable for server registration
+__all__ = ["analyze_reliability_growth", "forecast_growth_mtbf", "duane_fit", "crow_amsaa_fit"]
