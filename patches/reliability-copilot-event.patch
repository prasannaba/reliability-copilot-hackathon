+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { ModelPicker } from './ModelPicker';
+
+afterEach(cleanup);
+
+function picker(props?: Partial<Parameters<typeof ModelPicker>[0]>) {
+  const onSelect = vi.fn();
+  render(
+    <ModelPicker
+      models={['model-a', 'model-b']}
+      selectedModel="model-a"
+      modelsLoading={false}
+      onSelect={onSelect}
+      onManualCommit={() => undefined}
+      onRefresh={() => undefined}
+      {...props}
+    />,
+  );
+  return { onSelect };
+}
+
+describe('ModelPicker', () => {
+  it('closes the menu after a model is picked', () => {
+    const { onSelect } = picker();
+    const toggle = screen.getByRole('button');
+    fireEvent.click(toggle);
+    expect(toggle.getAttribute('aria-expanded')).toBe('true');
+
+    fireEvent.click(screen.getByText('model-b'));
+    expect(onSelect).toHaveBeenCalledWith('model-b');
+    expect(toggle.getAttribute('aria-expanded')).toBe('false');
+  });
+
+  it('keeps the menu open while typing a manual model id', () => {
+    picker();
+    const toggle = screen.getByRole('button');
+    fireEvent.click(toggle);
+    const input = screen.getByPlaceholderText(/llama3/i);
+    fireEvent.click(input);
+    expect(toggle.getAttribute('aria-expanded')).toBe('true');
+  });
+});
