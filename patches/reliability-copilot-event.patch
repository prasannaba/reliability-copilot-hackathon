+"""Unit tests for the deterministic life-data table parser.
+
+The parser is the single source of truth for pasted Time/Censored/Frequency
+tables: the LLM must never expand a Frequency column by hand (that path
+once misparsed n_units by 38%, skewing MTBF).
+"""
+
+import pytest
+
+from src.domains.reliability.tools.life_table import parse_life_data_table
+
+MARKDOWN_TABLE = """\
+| Time | Censored | Frequency |
+| ---- | -------- | --------- |
+| 54   | 0        | 1         |
+| 187  | 0        | 1         |
+| 500  | 1        | 10        |
+"""
+
+CSV_TABLE = "Time,Censored,Frequency\n54,0,1\n187,0,1\n500,1,10\n"
+
+
+def test_markdown_frequency_expansion_matches_sample_size():
+    out = parse_life_data_table(MARKDOWN_TABLE)
+    assert out["failure_times"] == [54.0, 187.0]
+    assert out["censored_times"] == [500.0] * 10
+    assert out["n_units"] == 12
+    assert out["n_failures"] == 2
+    assert out["n_censored"] == 10
+
+
+def test_csv_parses_identically_to_markdown():
+    assert parse_life_data_table(CSV_TABLE) == parse_life_data_table(MARKDOWN_TABLE)
+
+
+def test_headerless_positional_columns():
+    out = parse_life_data_table("54 0\n187 0\n500 1\n")
+    assert out["failure_times"] == [54.0, 187.0]
+    assert out["censored_times"] == [500.0]
+    assert out["n_units"] == 3
+
+
+def test_no_frequency_column_defaults_to_one_unit_per_row():
+    out = parse_life_data_table("Time Censored\n54 0\n500 1\n")
+    assert out["n_units"] == 2
+
+
+def test_bad_censored_flag_names_the_row():
+    with pytest.raises(ValueError, match="row 1.*censored flag must be 0 or 1"):
+        parse_life_data_table("Time Censored\n54 2\n")
+
+
+def test_no_failures_fails_loudly():
+    with pytest.raises(ValueError, match="no failures found"):
+        parse_life_data_table("Time Censored\n500 1\n")
+
+
+def test_non_integer_frequency_rejected():
+    with pytest.raises(ValueError, match="row 1.*frequency must be a positive integer"):
+        parse_life_data_table("Time Censored Frequency\n54 0 1.5\n")
+
+
+def test_unrecognized_column_rejected():
+    with pytest.raises(ValueError, match="unrecognized column"):
+        parse_life_data_table("Moment Flag\n54 0\n")
+
+
+def test_empty_table_rejected():
+    with pytest.raises(ValueError, match="no table provided"):
+        parse_life_data_table("   ")
