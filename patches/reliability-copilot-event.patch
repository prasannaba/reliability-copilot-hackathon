+        partial = self.buffer
+        if partial and (final or not _hold_partial(partial)):
+            self.buffer = ""
+            if _is_scaffold_line(partial):
+                if partial.strip():
+                    events.append(("thought", partial))
+            elif partial.strip() and partial.strip() == self._last_answer_line:
+                pass
+            else:
+                if partial.strip():
+                    self._last_answer_line = partial.strip()
+                events.append(("token", partial))
+        return events
+
+    def flush(self) -> list[tuple[str, str]]:
+        leftover = self.buffer
+        self.buffer = ""
+        if not leftover:
+            return []
+        if self._saw_scaffolding and self.mode == "answer":
+            # Segments first on the raw text (tokens delimit envelopes),
+            # then strip stragglers and line-drain the rest.
+            self.buffer = leftover
+            out = self._drain_segments(final=True)
+            rest = _ROLE_HEADER.sub("", _SCAFFOLD_TOKEN.sub("", self.buffer))
+            self.buffer = rest
+            out += self._drain_answer_lines(final=True)
+            return [(kind, text) for kind, text in out if text]
+        if self.mode == "thought" or self._in_think_tag:
+            return [("thought", leftover)]
+        thought, answer = split_thinking_from_answer(leftover)
+        out: list[tuple[str, str]] = []
+        if thought:
+            out.append(("thought", thought))
+        if answer:
+            out.append(("token", answer))
+        elif leftover and not thought:
+            out.append(("token", leftover))
+        return out
+
+    def _classify_prefix(self, prefix: str) -> list[tuple[str, str]]:
+        if not prefix:
+            return []
+        if self.mode == "thought" or _THOUGHT_HEAD.search(prefix):
+            self.mode = "thought"
+            return [("thought", prefix)]
+        self.mode = "answer"
+        return [("token", prefix)]
