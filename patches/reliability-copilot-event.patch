+  reasoningEffort: ReasoningEffort;
+  onReasoningEffortChange: (effort: ReasoningEffort) => void;
+}
+
+/** Single-Agent composer: no mode selector. Backend enforces tool grounding. */
+
+/** True when caret is on the first/last visual line (so ↑/↓ can walk history). */
+function isAtEdge(el: HTMLTextAreaElement, direction: "up" | "down"): boolean {
+  const val = el.value;
+  const start = el.selectionStart ?? 0;
+  const end = el.selectionEnd ?? val.length;
+  if (start !== end) return false;
+  if (!val.includes("\n")) return true;
+  if (direction === "up") return val.lastIndexOf("\n", start - 1) === -1;
+  return val.indexOf("\n", start) === -1;
 }
 
