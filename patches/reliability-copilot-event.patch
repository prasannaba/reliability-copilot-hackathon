+
+@needs_loop
+def test_non_data_turn_yields_before_pass_completes():
+    # Liveness: with no data digits in the turn the grounding guard can
+    # never fire, so the first event must stream before the inner pass
+    # finishes (the whole-pass buffer killed live streaming in the UI).
+    import asyncio
+    from types import SimpleNamespace
+
+    gate = asyncio.Event()
+
+    class _GatedHandler:
+        def stream_events(self):
+            async def gen():
+                yield SimpleNamespace(thought="still thinking")
+                await gate.wait()
+                yield SimpleNamespace(thought="done thinking")
+
+            return gen()
+
+        def __await__(self):
+            async def done():
+                return "final answer"
+
+            return done().__await__()
+
+    class _GatedAgent:
+        def __init__(self):
+            self.calls = []
+
+        def run(self, user_msg=None, ctx=None):
+            self.calls.append(user_msg)
+            return _GatedHandler()
+
+    async def main():
+        agent = _GatedAgent()
+        stream = stream_checked_agent_events(
+            agent, None, "Why can't we use normal distribution here?"
+        )
+        first = await asyncio.wait_for(stream.__anext__(), timeout=5)
+        assert first == {"type": "thought", "text": "still thinking"}
+        gate.set()
+        rest = [event async for event in stream]
+        assert rest[-1]["type"] == "done"
+        assert len(agent.calls) == 1
+
+    asyncio.run(main())
+
+
+@needs_loop
+def test_method_question_with_numbers_never_repairs_or_errors():
+    # The B10 bug: "B10" carries a digit, but a how-calculated question is
+    # an explanation, not a data turn — its numbers (percents, constants)
+    # must never trigger the grounding repair or the error event.
+    agent = _FakeAgent(
+        [[]],
+        finals=["B10 is the time by which 10% fail; Weibull scales eta at 63.2%."],
+    )
+    events = _collect(
+        agent, prompt="What is B10 life and how is it calculated?"
+    )
+    assert len(agent.calls) == 1
+    assert not [e for e in events if e["type"] == "error"]
+    assert not [e for e in events if e["type"] == "status"]
+
+
+def test_grounding_guard_skips_method_and_interpretation_questions():
+    from src.host.app import _needs_grounding_guard
+
+    # Explanations are never data turns, even with digits (B10, 63.2%).
+    assert not _needs_grounding_guard("What is B10 life and how is it calculated?")
+    assert not _needs_grounding_guard("Why 63.2%?")
+    assert not _needs_grounding_guard(
+        "Weibull RRY gives beta=2.64 but MLE gives beta=1.07.. which one to trust?"
+    )
+    assert not _needs_grounding_guard("Write a procedure for firmware reliability.")
+    # Genuine compute/data turns stay guarded.
+    assert _needs_grounding_guard("Fit Weibull to 150, 180, 220")
+    assert _needs_grounding_guard("Calculate B10 for beta 1.85 eta 452.3")
+    assert _needs_grounding_guard("Does B10 cover a 200 hour warranty?")
