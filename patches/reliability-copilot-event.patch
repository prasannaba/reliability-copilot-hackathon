+"""Simple chat image generation via the provider's responses API."""
+
+import base64
+import io
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+sys.path.append(str(Path(__file__).resolve().parents[1]))
+
+from src.host.app import generate_chat_image
+
+PNG_1PX = base64.b64decode(
+    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJ5ErkJggg=="
+)
+B64_1PX = base64.b64encode(PNG_1PX).decode("ascii")
+
+
+class _FakeResponses:
+    def __init__(self, output=None, error=None):
+        self._output = output if output is not None else [
+            SimpleNamespace(type="image_generation_call", result=B64_1PX)
+        ]
+        self._error = error
+        self.calls = []
+
+    def create(self, **kwargs):
+        self.calls.append(kwargs)
+        if self._error is not None:
+            raise self._error
+        return SimpleNamespace(output=self._output)
+
+
+class _FakeClient:
+    def __init__(self, responses):
+        self.responses = responses
+        self.kwargs = {}
+
+    @classmethod
+    def bind(cls, responses, seen):
+        def factory(**kwargs):
+            seen.append(kwargs)
+            return cls(responses)
+
+        return factory
+
+
+def _patch_client(monkeypatch, responses, seen):
+    import src.host.app as app
+
+    monkeypatch.setattr(app, "OpenAI", _FakeClient.bind(responses, seen))
+
+
+def test_empty_prompt_rejected(tmp_path):
+    with pytest.raises(RuntimeError, match="[Ee]mpty"):
+        generate_chat_image("  ", api_base="http://x/v1", api_key="k", static_dir=tmp_path)
+
+
+def test_missing_config_rejected(tmp_path):
+    with pytest.raises(RuntimeError):
+        generate_chat_image("a logo", api_base="", api_key="k", static_dir=tmp_path)
+    with pytest.raises(RuntimeError):
+        generate_chat_image("a logo", api_base="http://x/v1", api_key="", static_dir=tmp_path)
+
+
+def test_generate_saves_png(monkeypatch, tmp_path):
+    seen = []
+    _patch_client(monkeypatch, _FakeResponses(), seen)
+    result = generate_chat_image("a gold logo", api_base="http://x/v1", api_key="sk-T",
+                                 static_dir=tmp_path)
+    assert result["filename"].endswith(".png")
+    assert (tmp_path / result["filename"]).read_bytes()[:8] == b"\x89PNG\r\n\x1a\n"
+    assert result["url"] == f"/static/{result['filename']}"
+    assert seen[0]["base_url"] == "http://x/v1"
+    assert seen[0]["api_key"] == "sk-T"
+
+
+def test_generate_uses_default_model(monkeypatch, tmp_path):
+    monkeypatch.delenv("IMAGE_MODEL", raising=False)
+    responses = _FakeResponses()
+    seen = []
+    _patch_client(monkeypatch, responses, seen)
+    generate_chat_image("a logo", api_base="http://x/v1", api_key="k", static_dir=tmp_path)
+    assert responses.calls[0]["model"] == "muse-image-1.0"
+    assert responses.calls[0]["input"] == "a logo"
+
+
+def test_generate_is_deterministic(monkeypatch, tmp_path):
+    _patch_client(monkeypatch, _FakeResponses(), [])
+    first = generate_chat_image("same", api_base="http://x/v1", api_key="k",
+                                static_dir=tmp_path)
+    second = generate_chat_image("same", api_base="http://x/v1", api_key="k",
+                                 static_dir=tmp_path)
+    assert first["filename"] == second["filename"]
+
+
+def test_missing_image_block_errors(monkeypatch, tmp_path):
+    _patch_client(monkeypatch, _FakeResponses(output=[SimpleNamespace(type="text")]), [])
+    with pytest.raises(RuntimeError, match="[Nn]o image"):
+        generate_chat_image("a logo", api_base="http://x/v1", api_key="k",
+                            static_dir=tmp_path)
+
+
+def test_image_tools_only_on_meta_provider(monkeypatch):
+    import src.host.app as app
+
+    monkeypatch.setattr(app, "resolve_llm_provider", lambda: "meta")
+    assert [t.metadata.name for t in app._host_image_tools()] == ["generate_image"]
+    assert "generate_image" in app.image_prompt_line()
+    for provider in ("ollama", "baseten", "custom", "openai"):
+        monkeypatch.setattr(app, "resolve_llm_provider", lambda p=provider: p)
+        assert app._host_image_tools() == []
+        assert app.image_prompt_line() == ""
+
+
+def test_provider_error_translated_without_key_leak(monkeypatch, tmp_path):
+    _patch_client(monkeypatch, _FakeResponses(error=RuntimeError("Error code: 400 - nope")), [])
+    with pytest.raises(RuntimeError) as excinfo:
+        generate_chat_image("a logo", api_base="http://x/v1", api_key="sk-SECRET",
+                            static_dir=tmp_path)
+    assert "sk-SECRET" not in str(excinfo.value)
diff --git a/backend/tests/test_knowledge_docs.py b/backend/tests/test_knowledge_docs.py
new file mode 100644
index 0000000000000000000000000000000000000000..777ba839a48f815837db97e83df8c2bfd3a35888
--- /dev/null
+++ b/backend/tests/test_knowledge_docs.py
@@ -0,0 +1,167 @@
+import re
+import sys
+from pathlib import Path
+
+sys.path.append(str(Path(__file__).resolve().parents[1]))
+
+from src.knowledge.base import (
+    DEFAULT_MAX_TOKENS,
+    KNOWLEDGE_BASE_DIR,
+    _effective_chunk_budget,
+    _model_limit,
+    build_embedder,
+    default_chunk_budget,
+    default_token_count,
+    load_document,
+)
+
+KB_DIR = KNOWLEDGE_BASE_DIR
+
+
+def _read(name: str) -> str:
+    path = KB_DIR / name
+    assert path.is_file(), f"missing knowledge-base document: {name}"
+    return path.read_text(encoding="utf-8")
+
+
+def test_nist_apr_chapter_indexed_with_km_section():
+    text = _read("nist-apr-assessing-product-reliability.md")
+    assert len(text) > 100_000
+    assert "8.2.1.5" in text
+    assert "Kaplan-Meier" in text
+    assert "public domain" in text
+
+
+def test_nist_eda_chapter_indexed():
+    text = _read("nist-eda-exploratory-data-analysis.md")
+    assert len(text) > 100_000
+    assert "Exploratory Data Analysis" in text
+    assert "public domain" in text
+
+
+def test_no_product_references_in_knowledge_base():
+    for path in sorted(KB_DIR.glob("*.md")):
+        text = path.read_text(encoding="utf-8")
+        lowered = text.lower()
+        assert "reliasoft" not in lowered, path.name
+        assert "reliawiki" not in lowered, path.name
+
+
+def _longest_kb_heading() -> int:
+    longest_heading = 0
+    for path in sorted(KB_DIR.glob("*.md")):
+        for line in path.read_text(encoding="utf-8").splitlines():
+            match = re.match(r"^#{1,6}\s+(.+?)\s*$", line)
+            if match:
+                longest_heading = max(longest_heading, default_token_count(match.group(1)))
+    assert longest_heading > 0
+    return longest_heading
+
+
+def test_chunk_budget_leaves_headroom_for_embedder_limit():
+    # MiniLM 256-token window must still hold for anyone opting back into it.
+    assert (
+        default_chunk_budget("sentence-transformers/all-MiniLM-L6-v2") + _longest_kb_heading()
+        <= 256
+    )
+    # MiniLM default: documented 48-token header headroom on top of the budget.
+    assert DEFAULT_MAX_TOKENS == default_chunk_budget("sentence-transformers/all-MiniLM-L6-v2")
+    assert _longest_kb_heading() <= 48
+
+
+def test_stored_chunks_stay_within_budget(tmp_path):
+    kb = tmp_path / "kb"
+    kb.mkdir()
+    body = "\n\n".join(f"Paragraph {i} " + "word " * 300 for i in range(4))
+    (kb / "doc.md").write_text("# Section Header Words Here\n\n" + body, encoding="utf-8")
+    chunks = load_document(kb / "doc.md", kb, count_tokens=lambda text: len(text.split()))
+    assert chunks
+    header_words = len("Section Header Words Here".split())
+    assert all(len(chunk.text.split()) <= DEFAULT_MAX_TOKENS + header_words for chunk in chunks)
+
+
+def test_default_chunk_budget_per_family():
+    from src.knowledge.base import DEFAULT_EMBEDDING_MODEL
+
+    assert DEFAULT_EMBEDDING_MODEL == "sentence-transformers/all-MiniLM-L6-v2"
+    assert DEFAULT_MAX_TOKENS == 208
+    assert default_chunk_budget(None) == 208
+    assert default_chunk_budget("sentence-transformers/all-MiniLM-L6-v2") == 208
+    assert default_chunk_budget("google/embeddinggemma-2") == 512
+    assert default_chunk_budget("GOOGLE/EmbeddingGemma-2") == 512
+
+
+def test_effective_budget_clamps_to_live_limit():
+    class Stub:
+        def __init__(self, **attrs):
+            self.__dict__.update(attrs)
+
+    assert _model_limit(Stub(max_seq_length=256)) == 256
+    assert _model_limit(Stub(tokenizer=Stub(model_max_length=2048))) == 2048
+    assert _model_limit(Stub()) is None
+    assert _model_limit(Stub(max_seq_length=10**12)) is None
+    assert _effective_chunk_budget(Stub(), "sentence-transformers/all-MiniLM-L6-v2") == 208
+    assert _effective_chunk_budget(Stub(max_seq_length=256), None) == 208
+    assert _effective_chunk_budget(Stub(max_seq_length=100), None) == 64
+    assert _effective_chunk_budget(Stub(max_seq_length=4096), "google/embeddinggemma-2") == 512
+
+
+def test_build_embedder_skips_non_text_encoders_for_gemma(monkeypatch):
+    import sentence_transformers
+
+    seen = {}
+
+    class FakeST:
+        def __init__(self, *args, **kwargs):
+            seen["args"] = args
+            seen["kwargs"] = kwargs
+
+    monkeypatch.setattr(sentence_transformers, "SentenceTransformer", FakeST)
+    build_embedder("google/embeddinggemma-2")
+    assert seen["args"] == ("google/embeddinggemma-2",)
+    assert seen["kwargs"]["config_kwargs"] == {"vision_config": None, "audio_config": None}
+    build_embedder("sentence-transformers/all-MiniLM-L6-v2")
+    assert "config_kwargs" not in seen["kwargs"]
+
+
+def test_build_embedder_prefers_gpu_and_float32_on_cpu(monkeypatch):
+    import sentence_transformers
+    import torch
+
+    seen = {}
+
+    class FakeST:
+        def __init__(self, *args, **kwargs):
+            seen["args"] = args
+            seen["kwargs"] = kwargs
+
+    monkeypatch.setattr(sentence_transformers, "SentenceTransformer", FakeST)
+
+    monkeypatch.setattr(torch.cuda, "is_available", lambda: False)
+    build_embedder("google/embeddinggemma-2")
+    assert seen["kwargs"]["device"] == "cpu"
+    assert seen["kwargs"]["model_kwargs"] == {"torch_dtype": torch.float32}
+
+    monkeypatch.setattr(torch.cuda, "is_available", lambda: True)
+    build_embedder("google/embeddinggemma-2")
+    assert seen["kwargs"]["device"] == "cuda"
+    assert "model_kwargs" not in seen["kwargs"]
+
+    build_embedder("google/embeddinggemma-2", device="cpu")
+    assert seen["kwargs"]["device"] == "cpu"
+    assert seen["kwargs"]["model_kwargs"] == {"torch_dtype": torch.float32}
+
+
+def test_token_count_truncates_long_text(tmp_path):
+    from transformers import AutoTokenizer
+
+    from src.knowledge.base import GenericKnowledgeBase
+
+    kb = GenericKnowledgeBase(knowledge_base_dir=tmp_path, index_dir=tmp_path / ".rag")
+    kb._embedder = type(
+        "E",
+        (),
+        {"tokenizer": AutoTokenizer.from_pretrained("sentence-transformers/all-MiniLM-L6-v2")},
+    )()
+    count = kb._token_count("word " * 2000)
+    assert isinstance(count, int) and count <= 512
